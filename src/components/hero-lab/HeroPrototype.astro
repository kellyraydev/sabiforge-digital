---
interface Props {
  direction: 'human-digital' | 'atelier';
}

const { direction } = Astro.props;
const isHuman = direction === 'human-digital';
const intro = isHuman
  ? 'A warmer point of entry for businesses ready to be seen properly — where a human point of view meets interfaces made to move.'
  : 'A visual atelier for ambitious ideas — translating strategy into a composed system of type, texture, motion and useful code.';
---

<section
  class:list={['hero-prototype', isHuman ? 'hero-human' : 'hero-atelier']}
  aria-labelledby="prototype-title"
>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
  <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>

  <div class="container-page prototype-shell">
    <div class="prototype-topline">
      <p class="meta text-mint-300">SabiForge / Hero study {isHuman ? 'A' : 'B'}</p>
      <p class="meta text-ivory-100/50">Editorial precision × digital craftsmanship</p>
    </div>

    <div class="prototype-main">
      <div class="prototype-copy">
        <p class="eyebrow">
          <span>(00{isHuman ? '1' : '2'})</span>{' '}
          {isHuman ? 'Human × Digital' : 'Editorial Digital Atelier'}
        </p>
        <h1 id="prototype-title">
          {isHuman ? 'Human instinct.' : 'Make the invisible,'}
          <br />
          <em>{isHuman ? 'Digital precision.' : 'unmistakable.'}</em>
        </h1>
        <p class="prototype-intro">{intro}</p>
        <div class="prototype-actions">
          <a class="prototype-button prototype-button-primary" href="/contact">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
          <a
            class="prototype-text-link"
            href={isHuman ? '/hero-lab/atelier' : '/hero-lab/human-digital'}
          >
            View direction {isHuman ? 'B' : 'A'} <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="prototype-proof">
          <span class="proof-line"></span>
          <p>
            {isHuman
              ? 'A considered introduction for brands with a story to tell.'
              : 'A system-led introduction for ideas that need a world around them.'}
          </p>
        </div>
      </div>

      {isHuman ? (
        <div
          class="human-stage"
          aria-label="AI-generated editorial portrait beside a responsive website concept mockup"
        >
          <div class="human-ring ring-a"></div>
          <div class="human-ring ring-b"></div>
          <div class="portrait-frame">
            <img
              src="/assets/hero-lab/editorial-portrait.webp"
              width="1200"
              height="1500"
              alt="AI-generated editorial portrait study of an anonymous Black woman, used as provisional art direction"
              loading="eager"
              fetchpriority="high"
            />
            <div class="portrait-tag meta">Portrait study / provisional</div>
          </div>
          <div class="laptop-mockup">
            <div class="laptop-screen">
              <div class="mock-nav">
                <span class="mock-logo">kòrà</span>
                <span>Objects / Stories / Bag</span>
              </div>
              <div class="mock-body">
                <div>
                  <p class="mock-kicker">Objects for slow living</p>
                  <p class="mock-title">
                    Make room
                    <br />
                    <i>for ritual.</i>
                  </p>
                  <span class="mock-cta">Explore the collection →</span>
                </div>
                <div class="mock-product">
                  <span class="mock-sun"></span>
                  <span class="mock-orb"></span>
                  <span class="mock-caption">02 / 06</span>
                </div>
              </div>
            </div>
            <div class="laptop-base"></div>
          </div>
          <div class="phone-mockup">
            <div class="phone-notch"></div>
            <div class="phone-screen">
              <span class="phone-label">Sabi / 09:41</span>
              <span class="phone-glyph">S</span>
              <p>
                Small details,
                <br />
                <i>felt deeply.</i>
              </p>
              <span class="phone-bottom">Scroll to enter ↓</span>
            </div>
          </div>
          <span class="coordinate coordinate-one meta">06°31'N / 03°22'E</span>
          <span class="coordinate coordinate-two meta">S / 30°</span>
        </div>
      ) : (
        <div
          class="atelier-stage"
          aria-label="Layered editorial digital atelier interface composition"
        >
          <div class="atelier-word">
            FORM
            <br />
            <em>follows</em>
            <br />
            feeling.
          </div>
          <div class="atelier-window window-main">
            <div class="window-bar">
              <span>atelier / index—04</span>
              <span>↗</span>
            </div>
            <div class="window-content">
              <div class="window-glyph">S</div>
              <div>
                <p class="meta">A digital atelier for</p>
                <p class="window-heading">
                  Brands with
                  <br />
                  <i>something to say.</i>
                </p>
                <span class="window-rule"></span>
                <p class="window-note">Strategy / identity / interface / build</p>
              </div>
            </div>
          </div>
          <div class="atelier-card card-mint">
            <span class="meta">01 — signal</span>
            <strong>
              Clarity
              <br />
              before colour.
            </strong>
            <span class="card-arrow">↗</span>
          </div>
          <div class="atelier-card card-coral">
            <span class="meta">02 — shape</span>
            <strong>
              Useful
              <br />
              can be beautiful.
            </strong>
            <span class="card-arrow">↗</span>
          </div>
          <div class="atelier-spec meta">
            <span>TYPE / BRICOLAGE</span>
            <span>GRID / 12 COL</span>
            <span>MOTION / RESTRAINED</span>
          </div>
          <div class="atelier-dot dot-one"></div>
          <div class="atelier-dot dot-two"></div>
        </div>
      )}
    </div>

    <div class="prototype-footer">
      <span class="meta text-ivory-100/50">Scroll to explore the study</span>
      <span class="prototype-footer-line"></span>
      <span class="meta text-ivory-100/50">SabiForge Digital — Nigeria</span>
    </div>
  </div>
</section>

<style>
  .hero-prototype {
    position: relative;
    min-height: 820px;
    overflow: hidden;
    background: #031f25;
    color: #f7f3ea;
  }
  .hero-prototype::before {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 70% 30%, rgb(18 78 71 / 0.8), transparent 33%),
      radial-gradient(circle at 10% 85%, rgb(254 103 79 / 0.12), transparent 28%);
    content: '';
  }
  .prototype-shell {
    position: relative;
    z-index: 1;
    padding-top: 7.5rem;
    padding-bottom: 2rem;
  }
  .prototype-topline,
  .prototype-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(247 243 234 / 0.14);
    padding-bottom: 1rem;
  }
  .prototype-main {
    display: grid;
    min-height: 680px;
    grid-template-columns: minmax(280px, 0.78fr) 1.22fr;
    align-items: center;
    gap: 2rem;
  }
  .prototype-copy {
    position: relative;
    z-index: 3;
    max-width: 38rem;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #86f0d2;
    font:
      600 0.72rem/1 'JetBrains Mono Variable',
      monospace;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .eyebrow span {
    color: rgb(247 243 234 / 0.45);
  }
  h1 {
    margin-top: 1.4rem;
    max-width: 13ch;
    font:
      600 clamp(3.6rem, 6vw, 7.2rem)/0.88 'Bricolage Grotesque Variable',
      sans-serif;
    letter-spacing: -0.065em;
  }
  h1 em,
  .atelier-word em {
    color: #86f0d2;
    font:
      400 1.05em/0.8 'Instrument Serif',
      serif;
    letter-spacing: -0.03em;
  }
  .prototype-intro {
    margin-top: 2rem;
    max-width: 28rem;
    color: rgb(247 243 234 / 0.7);
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .prototype-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.2rem;
  }
  .prototype-button {
    display: inline-flex;
    gap: 1.5rem;
    align-items: center;
    padding: 0.95rem 1.3rem;
    font-weight: 700;
    transition:
      transform 0.3s ease,
      background-color 0.3s ease;
  }
  .prototype-button:hover {
    transform: translateY(-3px);
  }
  .prototype-button-primary {
    background: #fe674f;
    color: #031f25;
  }
  .prototype-text-link {
    color: #f7f3ea;
    text-decoration: underline;
    text-decoration-color: rgb(134 240 210 / 0.6);
    text-underline-offset: 0.45rem;
  }
  .prototype-proof {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    margin-top: 4.5rem;
    max-width: 21rem;
    color: rgb(247 243 234 / 0.48);
    font:
      0.72rem/1.5 'JetBrains Mono Variable',
      monospace;
  }
  .proof-line {
    width: 2.5rem;
    margin-top: 0.5rem;
    border-top: 1px solid #fe674f;
  }
  .human-stage,
  .atelier-stage {
    position: relative;
    min-height: 600px;
  }
  .human-stage {
    transform: translateX(2vw);
  }
  .human-ring {
    position: absolute;
    border: 1px solid rgb(134 240 210 / 0.32);
    border-radius: 50%;
  }
  .ring-a {
    top: 10%;
    left: 14%;
    width: 72%;
    aspect-ratio: 1;
  }
  .ring-b {
    top: 27%;
    left: 2%;
    width: 92%;
    aspect-ratio: 1;
    border-color: rgb(254 103 79 / 0.45);
    border-style: dashed;
    animation: orbit 24s linear infinite;
  }
  .portrait-frame {
    position: absolute;
    top: 4%;
    right: 17%;
    width: min(43%, 300px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgb(247 243 234 / 0.3);
    background: #124e47;
    box-shadow: 0 3rem 5rem rgb(0 0 0 / 0.35);
    transform: rotate(4deg);
  }
  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait-tag {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    padding: 0.4rem 0.55rem;
    background: #031f25;
    color: #86f0d2;
  }
  .laptop-mockup {
    position: absolute;
    bottom: 11%;
    left: 1%;
    width: 78%;
    transform: rotate(-5deg);
    filter: drop-shadow(0 2rem 2rem rgb(0 0 0 / 0.3));
  }
  .laptop-screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 9px solid #0b3a3f;
    border-radius: 0.75rem 0.75rem 0.2rem 0.2rem;
    background: #efe7da;
    color: #182c31;
  }
  .laptop-base {
    height: 0.85rem;
    margin: 0 -4%;
    border-radius: 0 0 50% 50%;
    background: #0b3a3f;
  }
  .mock-nav {
    display: flex;
    justify-content: space-between;
    padding: 3% 4%;
    border-bottom: 1px solid rgb(24 44 49 / 0.15);
    font:
      1.2cqw 'JetBrains Mono Variable',
      monospace;
  }
  .mock-logo {
    font: 700 2.7cqw 'Bricolage Grotesque Variable';
  }
  .mock-body {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4%;
    padding: 8% 6%;
  }
  .mock-kicker {
    color: #fe674f;
    font:
      1.4cqw 'JetBrains Mono Variable',
      monospace;
    text-transform: uppercase;
  }
  .mock-title {
    margin-top: 4%;
    font: 700 6.2cqw/0.85 'Bricolage Grotesque Variable';
    letter-spacing: -0.06em;
  }
  .mock-title i,
  .phone-screen i,
  .window-heading i {
    color: #e9503a;
    font: 400 1.1em/0.8 'Instrument Serif';
  }
  .mock-cta {
    display: inline-block;
    margin-top: 15%;
    padding: 2.5% 4%;
    background: #031f25;
    color: #f7f3ea;
    font:
      1.5cqw 'JetBrains Mono Variable',
      monospace;
  }
  .mock-product {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: #124e47;
  }
  .mock-sun {
    position: absolute;
    top: 10%;
    right: 8%;
    width: 45%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fe674f;
  }
  .mock-orb {
    position: absolute;
    bottom: 10%;
    left: 15%;
    width: 65%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #86f0d2, #124e47 68%);
  }
  .mock-caption {
    position: absolute;
    bottom: 5%;
    left: 5%;
    color: #f7f3ea;
    font: 1.2cqw 'JetBrains Mono Variable';
  }
  .phone-mockup {
    position: absolute;
    right: 1%;
    bottom: 5%;
    width: 18%;
    min-width: 100px;
    aspect-ratio: 0.49;
    padding: 2.3%;
    border: 5px solid #06292f;
    border-radius: 1.5rem;
    background: #06292f;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.35);
    transform: rotate(9deg);
  }
  .phone-screen {
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 11% 9%;
    background: #fe674f;
    color: #031f25;
  }
  .phone-notch {
    position: absolute;
    top: 1.5%;
    left: 32%;
    width: 36%;
    height: 2%;
    border-radius: 0 0 1rem 1rem;
    background: #031f25;
  }
  .phone-label,
  .phone-bottom {
    font: 1.7cqw 'JetBrains Mono Variable';
  }
  .phone-glyph {
    align-self: center;
    margin-top: 35%;
    font: 700 10cqw 'Bricolage Grotesque Variable';
  }
  .phone-screen p {
    font: 700 4.6cqw/0.85 'Bricolage Grotesque Variable';
    letter-spacing: -0.06em;
  }
  .coordinate {
    position: absolute;
    color: rgb(134 240 210 / 0.7);
  }
  .coordinate-one {
    top: 15%;
    left: 0;
    transform: rotate(-90deg);
  }
  .coordinate-two {
    right: 3%;
    top: 7%;
  }
  .atelier-stage {
    transform: translateX(3vw);
  }
  .atelier-word {
    position: absolute;
    z-index: 1;
    top: 7%;
    left: 3%;
    color: #f7f3ea;
    font: 700 clamp(4.5rem, 9vw, 9rem)/0.75 'Bricolage Grotesque Variable';
    letter-spacing: -0.1em;
  }
  .atelier-word em {
    color: #fe674f;
  }
  .atelier-window {
    position: absolute;
    z-index: 2;
    top: 25%;
    right: 5%;
    width: 68%;
    min-height: 48%;
    border: 1px solid rgb(247 243 234 / 0.35);
    background: rgb(3 31 37 / 0.82);
    box-shadow: 1.5rem 1.5rem 0 rgb(134 240 210 / 0.12);
    backdrop-filter: blur(12px);
  }
  .window-bar {
    display: flex;
    justify-content: space-between;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid rgb(247 243 234 / 0.2);
    color: rgb(247 243 234 / 0.6);
    font: 0.7rem 'JetBrains Mono Variable';
  }
  .window-content {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 1rem;
    padding: 2rem;
  }
  .window-glyph {
    display: grid;
    width: 5rem;
    height: 5rem;
    place-items: center;
    border: 1px solid #86f0d2;
    color: #86f0d2;
    font: 700 3rem 'Bricolage Grotesque Variable';
    transform: rotate(30deg);
  }
  .window-heading {
    margin-top: 0.8rem;
    font: 700 clamp(2rem, 4vw, 4.3rem)/0.83 'Bricolage Grotesque Variable';
    letter-spacing: -0.07em;
  }
  .window-rule {
    display: block;
    width: 5rem;
    margin-top: 2rem;
    border-top: 2px solid #fe674f;
  }
  .window-note {
    margin-top: 1.5rem;
    color: rgb(247 243 234 / 0.5);
    font: 0.65rem 'JetBrains Mono Variable';
  }
  .atelier-card {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    width: 33%;
    min-height: 31%;
    justify-content: space-between;
    padding: 1.2rem;
    color: #031f25;
    box-shadow: 1rem 1rem 0 rgb(3 31 37 / 0.25);
    transition: transform 0.35s ease;
  }
  .atelier-card:hover {
    transform: translateY(-8px) rotate(0);
  }
  .atelier-card strong {
    font: 700 clamp(1.3rem, 2vw, 2.2rem)/0.88 'Bricolage Grotesque Variable';
    letter-spacing: -0.05em;
  }
  .card-mint {
    bottom: 8%;
    left: 0;
    background: #86f0d2;
    transform: rotate(-7deg);
  }
  .card-coral {
    right: 2%;
    bottom: 0;
    background: #fe674f;
    transform: rotate(5deg);
  }
  .card-arrow {
    align-self: flex-end;
    font-size: 1.4rem;
  }
  .atelier-spec {
    position: absolute;
    right: 0;
    bottom: 44%;
    display: grid;
    gap: 0.45rem;
    color: rgb(247 243 234 / 0.55);
  }
  .atelier-dot {
    position: absolute;
    width: 1rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fe674f;
  }
  .dot-one {
    top: 13%;
    right: 8%;
  }
  .dot-two {
    bottom: 18%;
    left: 45%;
    background: #86f0d2;
  }
  .prototype-footer {
    border-top: 1px solid rgb(247 243 234 / 0.14);
    border-bottom: 0;
    padding-top: 1rem;
  }
  .prototype-footer-line {
    flex: 1;
    max-width: 16rem;
    border-top: 1px solid rgb(247 243 234 / 0.22);
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 900px) {
    .prototype-main {
      grid-template-columns: 1fr;
      padding-top: 4rem;
    }
    .prototype-copy {
      max-width: 32rem;
    }
    .prototype-copy h1 {
      font-size: clamp(3.5rem, 13vw, 6rem);
    }
    .prototype-intro {
      font-size: 1rem;
    }
    .prototype-proof {
      margin-top: 2rem;
    }
    .human-stage,
    .atelier-stage {
      min-height: 520px;
      margin-top: -1rem;
    }
    .prototype-shell {
      padding-top: 6rem;
    }
  }
  @media (max-width: 560px) {
    .hero-prototype {
      min-height: 900px;
    }
    .prototype-topline p:last-child {
      display: none;
    }
    .prototype-main {
      min-height: 780px;
      gap: 1rem;
    }
    .human-stage,
    .atelier-stage {
      min-height: 420px;
      transform: none;
    }
    .portrait-frame {
      right: 11%;
      width: 38%;
    }
    .laptop-mockup {
      bottom: 13%;
      left: -8%;
      width: 92%;
    }
    .phone-mockup {
      right: 0;
      bottom: 4%;
      width: 21%;
      min-width: 78px;
      border-width: 4px;
    }
    .coordinate-one {
      left: -3%;
    }
    .atelier-word {
      top: 3%;
      left: 0;
      font-size: clamp(3.4rem, 16vw, 5rem);
    }
    .atelier-window {
      top: 26%;
      right: 0;
      width: 88%;
    }
    .window-content {
      padding: 1.2rem;
      grid-template-columns: 0.5fr 1.5fr;
    }
    .window-glyph {
      width: 3.4rem;
      height: 3.4rem;
      font-size: 2rem;
    }
    .atelier-card {
      min-height: 31%;
      padding: 0.8rem;
    }
    .atelier-card strong {
      font-size: 1.2rem;
    }
    .atelier-spec {
      display: none;
    }
    .prototype-footer-line {
      max-width: 4rem;
    }
    .prototype-footer span:last-child {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring-b {
      animation: none;
    }
    .atelier-card:hover,
    .prototype-button:hover {
      transform: none;
    }
  }
</style>
