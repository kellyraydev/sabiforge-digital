---
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import HexLines from '@/components/ui/HexLines.astro';

interface Props {
  label: string;
  title: string;
  crumbs: { label: string; href?: string }[];
  class?: string;
}
const { label, title, crumbs, class: className } = Astro.props;
---

<section class:list={['relative isolate overflow-hidden pt-32 pb-16 lg:pt-44 lg:pb-24', className]}>
  <div
    class="absolute inset-0 -z-20 bg-[radial-gradient(60%_70%_at_85%_10%,rgb(91_33_182/0.5),transparent)]"
    aria-hidden="true"
  ></div>
  <HexLines
    class="absolute -top-24 -right-40 -z-10 size-[38rem] text-mint-300/10 lg:-right-16"
    rings={6}
  />
  <div class="container-page">
    <Breadcrumbs items={crumbs} />
    <div class="mt-10 grid gap-10 lg:grid-cols-[1.3fr_minmax(20rem,0.7fr)] lg:items-end">
      <div>
        <p class="meta text-mint-300" data-reveal>
          {label}
        </p>
        <h1 class="mt-5 text-display-xl font-semibold text-ivory-50" set:html={title} />
      </div>
      {Astro.slots.has('default') && (
        <div class="text-lede text-ivory-100/75">
          <slot />
        </div>
      )}
    </div>
    {Astro.slots.has('visual') && (
      <div class="mt-10 lg:mt-14 lg:ml-auto lg:w-[min(100%,34rem)]">
        <slot name="visual" />
      </div>
    )}
    <slot name="after" />
  </div>
</section>
