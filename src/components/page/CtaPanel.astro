---
/**
 * Page-specific closing call to action (v2). Pages that use it turn off the footer's
 * generic band (BaseLayout footerCta={false}) so each page ends with one CTA.
 */
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { startProjectHref, whatsappLink } from '@/data/site';

interface Props {
  title: string;
  body: string;
  primaryLabel?: string;
  primaryHref?: string;
  whatsappMessage?: string;
}
const {
  title,
  body,
  primaryLabel = 'Start your project',
  primaryHref = startProjectHref,
  whatsappMessage,
} = Astro.props;
---

<section class="py-16 lg:py-24" aria-labelledby="cta-title">
  <div class="container-page">
    <div
      class="relative overflow-hidden rounded-[1.75rem] border border-coral-400/25 bg-[linear-gradient(110deg,rgb(124_58_237/0.32),rgb(23_29_69/0.9)_45%,rgb(46_230_196/0.14))] px-6 py-10 sm:px-10 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:px-14 lg:py-12"
      data-reveal
    >
      <div class="flex items-start gap-5">
        <span
          class="hidden size-14 shrink-0 items-center justify-center rounded-2xl border border-ivory-100/15 bg-midnight-900/60 text-coral-300 sm:flex"
          aria-hidden="true"
        >
          <Icon name="arrow-up-right" class="size-7" />
        </span>
        <div>
          <h2
            id="cta-title"
            class="font-display text-display-sm font-semibold text-ivory-50"
            set:html={title}
          />
          <p class="mt-2 max-w-xl text-ivory-100/75">{body}</p>
        </div>
      </div>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row lg:mt-0 lg:shrink-0">
        <Button href={primaryHref} size="lg" icon="arrow-right">
          {primaryLabel}
        </Button>
        <Button
          href={whatsappLink(whatsappMessage)}
          variant="secondary"
          size="lg"
          icon="whatsapp"
          iconPosition="start"
          external
        >
          WhatsApp
        </Button>
      </div>
    </div>
  </div>
</section>
