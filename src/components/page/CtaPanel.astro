---
import Icon from '@/components/ui/Icon.astro';
import HexLines from '@/components/ui/HexLines.astro';
import { startProjectHref, whatsappLink } from '@/data/site';

interface Props {
  title: string;
  body: string;
  primaryLabel?: string;
  primaryHref?: string;
  whatsappMessage?: string;
}
const {
  title,
  body,
  primaryLabel = 'Start a project',
  primaryHref = startProjectHref,
  whatsappMessage,
} = Astro.props;
---

<section class="py-20 lg:py-28" aria-labelledby="cta-title">
  <div class="container-page">
    <div
      class="chamfer relative isolate overflow-hidden rounded-[var(--radius-card)] bg-mint-300 px-6 py-12 text-midnight-900 sm:px-12 lg:px-16 lg:py-16"
      data-reveal
    >
      <HexLines class="absolute -right-24 -bottom-40 -z-10 size-[30rem] text-midnight-900/15" />
      <div class="grid gap-8 lg:grid-cols-[1.4fr_auto] lg:items-end">
        <div>
          <h2 id="cta-title" class="text-display-md font-semibold" set:html={title} />
          <p class="mt-4 max-w-xl text-lg text-midnight-900/80">{body}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href={primaryHref}
            class="group inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-midnight-900 px-7 font-semibold text-ivory-50 transition hover:bg-midnight-700"
          >
            {primaryLabel}
            <Icon name="arrow-up-right" class="size-5 transition group-hover:translate-x-0.5" />
          </a>
          <a
            href={whatsappLink(whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-midnight-900/40 px-7 font-semibold transition hover:border-midnight-900"
          >
            <Icon name="whatsapp" class="size-5" /> WhatsApp
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
