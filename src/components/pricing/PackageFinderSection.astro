---
/** "Which package fits me?" block, shared by the homepage and /pricing. */
import PackageFinder from '@/components/pricing/PackageFinder';
import { packages, foundingPrice } from '@/data/packages';
import { formatNaira, discountPercentLabel } from '@/lib/pricing';
import { site, whatsappLink } from '@/data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const finderPackages = packages.map((pkg) => {
  const founding = foundingPrice(pkg);
  return {
    id: pkg.id,
    name: pkg.name,
    priceLabel:
      pkg.price === null
        ? 'Custom quote'
        : `${pkg.fromPrice ? 'From ' : ''}${formatNaira(pkg.price)}`,
    foundingLabel:
      pkg.foundingEligible && founding !== null
        ? `${formatNaira(founding)} at the founding rate (${discountPercentLabel()} off)`
        : null,
  };
});
---

<div class:list={['grid gap-6 lg:grid-cols-[minmax(0,20rem)_1fr] lg:items-start', className]}>
  <div>
    <h3 class="font-display text-2xl font-semibold text-ivory-50">Not sure which package fits?</h3>
    <p class="mt-3 text-ivory-100/70">
      Answer up to three quick questions and we’ll suggest one. Nothing is sent until you choose to
      get in touch.
    </p>
  </div>
  <div>
    <PackageFinder
      client:idle
      packages={finderPackages}
      whatsappNumber={site.contact.whatsappNumber}
    />
    <noscript>
      <p class="mt-3 text-sm text-ivory-100/70">
        The finder needs JavaScript.{' '}
        <a href={whatsappLink()} class="font-semibold text-mint-300 underline">
          Message us on WhatsApp
        </a>{' '}
        and we’ll suggest a package.
      </p>
    </noscript>
  </div>
</div>
