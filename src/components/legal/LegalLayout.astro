---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import { LEGAL_STATUS, decisionsFor, type OwnerDecision } from '@/data/legal';

interface Props {
  title: string;
  heading: string;
  description: string;
  document: OwnerDecision['document'];
  sections: { id: string; label: string }[];
}
const { title, heading, description, document, sections } = Astro.props;
const register = decisionsFor(document);
const toc = [...sections, { id: 'decisions', label: 'Decisions the owner must make' }];
---

<BaseLayout title={`${title} (draft)`} description={description} noindex>
  <section class="relative isolate overflow-hidden pt-32 pb-10 lg:pt-40">
    <div class="container-page">
      <Breadcrumbs items={[{ label: title }]} />
      <p class="meta mt-10 text-mint-300">Draft for owner review</p>
      <h1 class="mt-4 text-display-lg font-semibold text-ivory-50">{heading}</h1>

      <div
        class="mt-8 rounded-2xl border-2 border-coral-400 bg-coral-400/10 p-6 sm:p-8"
        role="note"
        aria-label="Draft status"
      >
        <p class="flex items-start gap-3 text-lg font-semibold text-ivory-50">
          <Icon name="alert" class="mt-1 size-6 shrink-0 text-coral-300" />
          This is a working draft, not an approved legal document. Do not rely on it, and do not
          publish it without review by a qualified Nigerian legal adviser.
        </p>
        <p class="mt-3 max-w-3xl text-ivory-100/80">
          It states only facts that can be verified from this website and the approved pricing.
          Where a term depends on a business or legal decision, it says so and points to an owner
          decision below. Nothing here has been invented to fill a gap.
        </p>
        <dl class="mt-5 grid gap-x-8 gap-y-1 text-sm text-ivory-100/80 sm:grid-cols-4">
          <div>
            <dt class="meta text-coral-300">Version</dt>
            <dd>{LEGAL_STATUS.version}</dd>
          </div>
          <div>
            <dt class="meta text-coral-300">Drafted</dt>
            <dd>{LEGAL_STATUS.drafted}</dd>
          </div>
          <div>
            <dt class="meta text-coral-300">Owner approved</dt>
            <dd>{LEGAL_STATUS.approved ? 'Yes' : 'No'}</dd>
          </div>
          <div>
            <dt class="meta text-coral-300">Legal review</dt>
            <dd>{LEGAL_STATUS.reviewedByCounsel ? 'Yes' : 'No'}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="pb-24 lg:pb-32">
    <div class="container-page grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-16">
      <nav aria-label="On this page" class="lg:sticky lg:top-28 lg:self-start">
        <p class="meta text-ivory-100/60">On this page</p>
        <ol class="mt-4 space-y-2 text-sm">
          {toc.map((s, i) => (
            <li>
              <a href={`#${s.id}`} class="link-sweep text-ivory-100/80 hover:text-ivory-50">
                <span class="meta mr-2 text-mint-300">{String(i + 1).padStart(2, '0')}</span>
                {s.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="on-paper rounded-[var(--radius-card)] bg-ivory-50 p-6 text-midnight-900 sm:p-10 lg:p-14">
        <div class="prose-sf max-w-3xl [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2:first-child]:mt-0 [&_li]:mt-2 [&_p]:mt-3 [&_p]:leading-relaxed [&_ul]:list-disc [&_ul]:pl-6">
          <slot />

          <h2 id="decisions">Decisions the owner must make</h2>
          <p>
            Each row is a question the finished document needs an answer to. Answers should come
            from the business owner, and wording should be checked by a legal adviser.
          </p>
          <div
            class="mt-5 overflow-x-auto rounded-lg border border-midnight-900/20"
            tabindex="0"
            role="region"
            aria-label={`Owner decision register for ${title}`}
          >
            <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
              <caption class="sr-only">Owner decisions required for the{title}</caption>
              <thead class="bg-midnight-900 text-ivory-50">
                <tr>
                  <th scope="col" class="px-4 py-3">
                    Ref
                  </th>
                  <th scope="col" class="px-4 py-3">
                    Topic
                  </th>
                  <th scope="col" class="px-4 py-3">
                    Decision needed
                  </th>
                </tr>
              </thead>
              <tbody class="align-top">
                {register.map((d) => (
                  <tr class="border-t border-midnight-900/15">
                    <th scope="row" class="px-4 py-3 font-mono text-xs">
                      {d.id}
                    </th>
                    <td class="px-4 py-3 font-semibold">{d.topic}</td>
                    <td class="px-4 py-3">{d.question}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
