---
import Icon from '@/components/ui/Icon.astro';

const products = [
  { name: 'Wireless headphones', price: '₦75,000', shape: 'headphones' },
  { name: 'Smart watch', price: '₦48,500', shape: 'watch' },
  { name: 'Travel backpack', price: '₦32,000', shape: 'bag' },
] as const;
---

<figure class="mx-auto w-full max-w-[36rem] lg:max-w-none">
  <div class="relative">
    <!-- Glow -->
    <div
      class="absolute -inset-8 -z-10 rounded-[3rem] bg-[radial-gradient(closest-side,rgb(134_240_210/0.22),transparent)] blur-2xl"
      aria-hidden="true"
    ></div>

    <!-- Browser frame -->
    <div
      class="overflow-hidden rounded-2xl border border-ivory-100/10 bg-ivory-50 shadow-[0_40px_80px_-30px_rgb(0_0_0/0.8)]"
      aria-hidden="true"
    >
      <div class="flex items-center gap-2 border-b border-midnight-900/10 bg-ivory-100 px-4 py-3">
        <span class="size-2.5 rounded-full bg-coral-500"></span>
        <span class="size-2.5 rounded-full bg-[#f5c451]"></span>
        <span class="size-2.5 rounded-full bg-mint-400"></span>
        <span class="ml-3 flex h-6 flex-1 items-center gap-1.5 rounded-full bg-white px-3 text-[0.65rem] text-midnight-800/80">
          <Icon name="shield" class="size-3" /> your-store / home
        </span>
      </div>

      <div class="p-3 sm:p-4">
        <div class="flex items-center justify-between px-1 pb-3 text-midnight-900">
          <span class="font-display text-sm font-bold">Your Store</span>
          <span class="hidden gap-4 text-[0.65rem] text-midnight-800/80 sm:flex">
            <span>Shop</span>
            <span>Categories</span>
            <span>Deals</span>
          </span>
          <Icon name="cart" class="size-4" />
        </div>

        <div class="relative overflow-hidden rounded-xl bg-[linear-gradient(120deg,#06292f_0%,#124e47_60%,#1b6157_100%)] p-5 sm:p-6">
          <div class="absolute -right-10 -bottom-16 size-48 rounded-full bg-mint-300/25 blur-2xl"></div>
          <p class="text-[0.6rem] font-semibold tracking-[0.2em] text-mint-300 uppercase">
            New season
          </p>
          <p class="mt-2 max-w-[13rem] font-display text-xl leading-tight font-semibold text-ivory-50 sm:text-2xl">
            Modern stores, built to convert.
          </p>
          <span class="mt-4 inline-flex h-7 items-center rounded-full bg-coral-500 px-3 text-[0.65rem] font-semibold text-midnight-950">
            Shop now →
          </span>
          <!-- Sneaker-like product glyph -->
          <svg
            viewBox="0 0 160 80"
            class="absolute right-3 bottom-4 w-32 sm:right-6 sm:w-40"
            aria-hidden="true"
          >
            <path
              d="M8 58c0-8 6-12 14-14l30-6c8-2 14-10 20-18 4-5 10-6 14-2l6 6c4 4 10 6 16 6h12c14 0 26 10 30 24v6H8z"
              fill="#fdfbf6"
            ></path>
            <path d="M60 44c14 6 34 6 52 2" stroke="#12715d" stroke-width="7" fill="none"></path>
            <rect x="6" y="62" width="150" height="10" rx="5" fill="#ece5d6"></rect>
          </svg>
        </div>

        <div class="mt-3 grid grid-cols-3 gap-2 sm:gap-3">
          {products.map((product) => (
            <div class="rounded-lg bg-ivory-100 p-2 sm:p-3">
              <div class="flex aspect-square items-center justify-center rounded-md bg-white">
                {product.shape === 'headphones' && (
                  <svg viewBox="0 0 40 40" class="w-3/5" fill="none" aria-hidden="true">
                    <path d="M8 24v-4a12 12 0 0 1 24 0v4" stroke="#06292f" stroke-width="3" />
                    <rect x="5" y="22" width="8" height="12" rx="3" fill="#06292f" />
                    <rect x="27" y="22" width="8" height="12" rx="3" fill="#06292f" />
                  </svg>
                )}
                {product.shape === 'watch' && (
                  <svg viewBox="0 0 40 40" class="w-3/5" aria-hidden="true">
                    <rect x="14" y="2" width="12" height="36" rx="4" fill="#5a4636" />
                    <rect x="9" y="11" width="22" height="18" rx="6" fill="#06292f" />
                    <circle cx="20" cy="20" r="5" fill="none" stroke="#fe674f" stroke-width="2" />
                  </svg>
                )}
                {product.shape === 'bag' && (
                  <svg viewBox="0 0 40 40" class="w-3/5" aria-hidden="true">
                    <path d="M14 10a6 6 0 0 1 12 0" stroke="#0b3a3f" stroke-width="3" fill="none" />
                    <rect x="8" y="10" width="24" height="27" rx="6" fill="#0b3a3f" />
                    <rect x="13" y="22" width="14" height="9" rx="2" fill="#1b6157" />
                  </svg>
                )}
              </div>
              <p class="mt-2 truncate text-[0.6rem] text-midnight-800/70">{product.name}</p>
              <p class="text-[0.7rem] font-semibold text-midnight-900">{product.price}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Phone frame -->
    <div
      class="animate-float absolute -right-2 -bottom-10 w-[34%] max-w-[11rem] rounded-[1.6rem] border-[5px] border-midnight-950 bg-ivory-50 p-2 shadow-[0_30px_60px_-20px_rgb(0_0_0/0.85)] sm:-right-6"
      aria-hidden="true"
    >
      <div class="mx-auto mb-2 h-1.5 w-10 rounded-full bg-midnight-900/15"></div>
      <div class="flex aspect-square items-center justify-center rounded-xl bg-ivory-200">
        <svg viewBox="0 0 40 40" class="w-1/2" fill="none">
          <path d="M8 24v-4a12 12 0 0 1 24 0v4" stroke="#06292f" stroke-width="3"></path>
          <rect x="5" y="22" width="8" height="12" rx="3" fill="#06292f"></rect>
          <rect x="27" y="22" width="8" height="12" rx="3" fill="#06292f"></rect>
        </svg>
      </div>
      <p class="mt-2 text-[0.6rem] text-midnight-800/70">Wireless headphones</p>
      <p class="text-xs font-bold text-midnight-900">₦75,000</p>
      <span class="mt-2 flex h-6 items-center justify-center rounded-full bg-coral-500 text-[0.55rem] font-semibold text-midnight-950">
        Add to cart
      </span>
    </div>

    <!-- Floating chips -->
    <div
      class="absolute -top-14 right-4 hidden items-center gap-2 rounded-full border border-ivory-100/10 bg-midnight-800/90 px-3 py-2 text-xs font-medium text-ivory-50 shadow-lg backdrop-blur sm:flex"
      aria-hidden="true"
    >
      <span class="flex size-6 items-center justify-center rounded-full bg-mint-300 text-midnight-900">
        <Icon name="phone" class="size-3.5" strokeWidth={2.2} />
      </span>
      Responsive on every screen
    </div>
    <div
      class="absolute -bottom-6 left-6 hidden items-center gap-2 rounded-full border border-ivory-100/10 bg-midnight-800/90 px-3 py-2 text-xs font-medium text-ivory-50 shadow-lg backdrop-blur sm:flex lg:-left-6"
      aria-hidden="true"
    >
      <span class="flex size-6 items-center justify-center rounded-full bg-coral-500 text-midnight-950">
        <Icon name="whatsapp" class="size-3.5" strokeWidth={2.2} />
      </span>
      Orders straight to WhatsApp
    </div>
  </div>

  <figcaption class="mt-8 max-w-[58%] text-xs leading-relaxed text-ivory-100/60 sm:mt-16">
    Illustrative store concept — sample products and prices.
  </figcaption>
</figure>
