---
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconKey } from '@/lib/icons';

const swatches = [
  { name: 'Midnight', hex: '#031F25', cls: 'bg-midnight-900 ring-1 ring-ivory-100/20' },
  { name: 'Mint', hex: '#86F0D2', cls: 'bg-mint-300' },
  { name: 'Coral', hex: '#FE674F', cls: 'bg-coral-500' },
  { name: 'Ivory', hex: '#F7F3EA', cls: 'bg-ivory-100' },
];

const checks: { icon: IconKey; title: string; detail: string }[] = [
  {
    icon: 'contrast',
    title: 'Contrast is measured, not eyeballed',
    detail:
      'White text on our coral measures 2.9:1 and fails WCAG AA, so every coral button uses midnight ink instead (5.9:1).',
  },
  {
    icon: 'keyboard',
    title: 'Keyboard and focus',
    detail:
      'Menus, tabs and selectors on this site work with arrow keys, Tab and Escape, with a visible focus ring on every control.',
  },
  {
    icon: 'monitor',
    title: 'Seven screen widths',
    detail:
      'Every page is rendered at 375, 390, 430, 768, 1280, 1440 and 1920 pixels and checked for overflow, broken links and console errors.',
  },
  {
    icon: 'gauge',
    title: 'JavaScript only where it earns its place',
    detail:
      'Pages ship as static HTML. Interactive parts load their code only when needed, and motion respects reduced-motion settings.',
  },
];
---

<section
  aria-labelledby="method-title"
  class="defer-render relative border-t border-ivory-100/10 bg-midnight-950 py-24 lg:py-36"
>
  <div class="container-page">
    <SectionHead
      index="08"
      label="Studio method"
      id="method-title"
      title="Evidence of craft, <em>not</em> claims."
    >
      <p>
        We don’t have client testimonials to show yet, and we won’t invent them. What we can show is
        how we work, starting with the website you are reading.
      </p>
    </SectionHead>

    <div class="mt-16 grid gap-6 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
      <figure
        class="chamfer rounded-[var(--radius-card)] bg-midnight-800/80 p-7 sm:p-10"
        data-reveal
      >
        <figcaption class="meta flex items-center justify-between text-ivory-100/65">
          <span>This site’s design system</span>
          <span>Live tokens</span>
        </figcaption>

        <div class="mt-8 grid grid-cols-4 gap-3">
          {swatches.map((s) => (
            <div>
              <div class:list={['aspect-[4/5] rounded-xl', s.cls]} />
              <p class="mt-3 text-sm font-semibold text-ivory-50">{s.name}</p>
              <p class="meta text-ivory-100/60">{s.hex}</p>
            </div>
          ))}
        </div>

        <div class="mt-10 grid gap-6 border-t border-ivory-100/12 pt-8 sm:grid-cols-3">
          <div>
            <p class="font-display text-5xl font-semibold text-ivory-50">Aa</p>
            <p class="meta mt-2 text-ivory-100/60">Bricolage Grotesque — display</p>
          </div>
          <div>
            <p class="font-serif text-5xl text-ivory-50 italic">Aa</p>
            <p class="meta mt-2 text-ivory-100/60">Instrument Serif — accent</p>
          </div>
          <div>
            <p class="font-mono text-5xl text-ivory-50">Aa</p>
            <p class="meta mt-2 text-ivory-100/60">JetBrains Mono — metadata</p>
          </div>
        </div>

        <div
          class="mt-10 flex flex-wrap items-center gap-3 border-t border-ivory-100/12 pt-8"
          aria-hidden="true"
        >
          <span class="inline-flex min-h-11 items-center rounded-full bg-coral-500 px-5 text-sm font-semibold text-midnight-950">
            Primary
          </span>
          <span class="inline-flex min-h-11 items-center rounded-full border border-ivory-100/25 px-5 text-sm font-semibold text-ivory-50">
            Secondary
          </span>
          <span class="inline-flex min-h-11 items-center rounded-full bg-coral-500 px-5 text-sm font-semibold text-midnight-950 outline-3 outline-offset-3 outline-mint-300">
            Focused
          </span>
          <span class="meta text-ivory-100/60">5.9:1 contrast</span>
        </div>
      </figure>

      <ul class="grid content-start self-start gap-px overflow-hidden rounded-[var(--radius-card)] bg-ivory-100/10">
        {checks.map((check, index) => (
          <li class="bg-midnight-950 p-7 sm:p-8" data-reveal style={`--reveal-delay:${index * 70}`}>
            <div class="flex items-start gap-5">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full border border-mint-300/30 text-mint-300">
                <Icon name={check.icon} class="size-5" />
              </span>
              <div>
                <h3 class="text-lg font-semibold text-ivory-50">{check.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-relaxed text-ivory-100/75">{check.detail}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <p class="meta mt-6 text-ivory-100/60" data-reveal>
      Studio note: automated checks catch many issues but don’t prove full accessibility; manual
      review is part of the process.
    </p>
  </div>
</section>
