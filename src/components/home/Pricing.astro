---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PricingPreview, { type PricingCard } from './PricingPreview';
import { packages, foundingPrice } from '@/data/content';
import { whatsappLink } from '@/data/site';
import { FOUNDING_CLIENT_SLOTS, discountPercentLabel, formatNaira } from '@/lib/pricing';

const cards: PricingCard[] = packages.map((pkg) => ({
  id: pkg.id,
  icon: pkg.icon,
  name: pkg.name,
  summary: pkg.summary,
  standard: formatNaira(pkg.price),
  founding: formatNaira(foundingPrice(pkg)),
  foundingEligible: pkg.foundingEligible,
  fromPrice: Boolean(pkg.fromPrice),
  features: pkg.features,
  featured: Boolean(pkg.featured),
  enquiryHref: whatsappLink(`Hello SabiForge Digital, I'm interested in the ${pkg.name} package.`),
}));
---

<section id="pricing" aria-labelledby="pricing-title" class="relative py-24 lg:py-32">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-full bg-[radial-gradient(60%_50%_at_50%_0%,rgb(18_78_71/0.6),transparent)]"
    aria-hidden="true"
  ></div>
  <div class="container-page">
    <SectionHeading
      id="pricing-title"
      eyebrow="Website packages"
      align="center"
      title="Clear packages. <span class='text-mint-300'>No guesswork.</span>"
    >
      Start with a published price, then we confirm the exact scope in a written proposal before any
      work begins.
    </SectionHeading>

    <div class="mt-14">
      <PricingPreview
        client:visible
        cards={cards}
        discountLabel={discountPercentLabel()}
        slots={FOUNDING_CLIENT_SLOTS}
      />
    </div>

    <p class="mx-auto mt-8 max-w-3xl text-center text-xs leading-relaxed text-ivory-100/60">
      Introductory prices in Nigerian naira. Final scope and third-party costs — such as domain
      registration, hosting, premium themes or plugins, Shopify subscriptions and payment-gateway
      fees — are quoted separately.
    </p>
  </div>
</section>
