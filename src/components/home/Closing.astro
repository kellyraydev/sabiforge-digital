---
import LogoMark from '@/components/ui/LogoMark.astro';
import HexLines from '@/components/ui/HexLines.astro';
import Icon from '@/components/ui/Icon.astro';
import { site, startProjectHref, whatsappLink, mailtoLink } from '@/data/site';
---

<section
  aria-labelledby="closing-title"
  class="defer-render relative isolate overflow-hidden py-24 lg:py-40"
>
  <HexLines
    class="absolute top-1/2 right-[-12rem] -z-10 w-[48rem] -translate-y-1/2 text-mint-300/10 lg:right-[-6rem]"
    rings={8}
  />
  <div class="container-page grid gap-14 lg:grid-cols-[1.35fr_1fr] lg:items-center">
    <div>
      <p class="meta flex items-center gap-3 text-mint-300" data-reveal>
        <span aria-hidden="true">(07)</span>
        <span>Start your project</span>
      </p>
      <h2 id="closing-title" class="mt-6 text-display-xl font-semibold text-ivory-50" data-reveal>
        Bring us the problem. We’ll <em class="text-coral-400">shape</em> what comes next.
      </h2>
      <p class="text-lede mt-8 max-w-xl text-ivory-100/75" data-reveal>
        Whether it is your first website or a long-overdue redesign, the first conversation is about
        your business — not a sales pitch. You’ll leave it with a clearer idea of what you need.
      </p>
    </div>

    <div class="relative" data-reveal style="--reveal-delay:150">
      <LogoMark class="absolute -top-36 right-6 -z-10 hidden h-64 w-auto opacity-90 lg:block" />
      <div class="chamfer rounded-[var(--radius-card)] bg-ivory-100 p-7 text-midnight-900 sm:p-9">
        <p class="meta text-mint-800">Two ways to begin</p>
        <a
          href={startProjectHref}
          class="group mt-5 flex items-center justify-between gap-4 rounded-2xl bg-coral-600 p-5 font-display text-xl font-semibold text-white transition hover:bg-coral-700"
        >
          <span>
            Start your project
            <span class="mt-1 block font-sans text-sm font-normal text-white/90">
              A short brief, about 3 minutes
            </span>
          </span>
          <Icon name="arrow-up-right" class="size-6 transition group-hover:translate-x-0.5" />
        </a>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center gap-2.5 rounded-2xl border border-midnight-900/15 px-4 font-semibold hover:border-midnight-900"
          >
            <Icon name="whatsapp" class="size-5" /> WhatsApp
            <span class="sr-only">(opens in a new tab)</span>
          </a>
          <a
            href={mailtoLink('Project enquiry')}
            class="flex min-h-12 items-center gap-2.5 rounded-2xl border border-midnight-900/15 px-4 font-semibold hover:border-midnight-900"
          >
            <Icon name="mail" class="size-5" /> Email
          </a>
        </div>
        <p class="mt-6 text-sm text-midnight-800/75">
          Or call{' '}
          <a href={site.contact.phoneHref} class="font-semibold underline underline-offset-4">
            {site.contact.whatsappDisplay}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>
