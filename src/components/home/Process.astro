---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ProcessSteps from './ProcessSteps';
import { processSteps } from '@/data/content';
---

<section
  id="process"
  aria-labelledby="process-title"
  class="relative border-y border-ivory-100/10 bg-midnight-950 py-24 lg:py-32"
>
  <div class="container-page">
    <SectionHeading
      id="process-title"
      eyebrow="How we work"
      title="Six clear steps from <span class='text-mint-300'>first chat</span> to <span class='text-coral-500'>go-live</span>."
    >
      You always know what is happening, what you need to provide and what comes next.
    </SectionHeading>
    <div class="mt-14">
      <ProcessSteps client:visible steps={processSteps} />
    </div>
  </div>
</section>
