---
import Button from '@/components/ui/Button.astro';
import HexLines from '@/components/ui/HexLines.astro';
import { startProjectHref } from '@/data/site';
---

<section aria-labelledby="hero-title" class="flagship-hero relative isolate overflow-hidden">
  <div class="hero-wash" aria-hidden="true"></div>
  <HexLines
    class="hero-hex absolute right-[-14rem] top-[8rem] -z-10 w-[48rem] text-mint-300/15"
    rings={8}
  />
  <div class="container-page hero-container">
    <div class="hero-copy">
      <p class="meta hero-kicker" data-reveal>
        <span aria-hidden="true">(01)</span> SabiForge Digital · Nigeria
      </p>
      <h1 id="hero-title" data-reveal>
        Distinctive websites.
        <br />
        <em>Designed to stand out.</em>
        <br />
        Built to move business forward.
      </h1>
      <p class="hero-lede" data-reveal style="--reveal-delay:100">
        We design and develop custom websites and online stores, modernize existing websites, and
        provide ongoing website care for businesses in Nigeria.
      </p>
      <div class="hero-actions" data-reveal style="--reveal-delay:180">
        <Button href={startProjectHref} size="lg" icon="arrow-up-right">
          Start a project
        </Button>
        <Button href="/work" variant="secondary" size="lg" icon="arrow-right">
          Explore our work
        </Button>
      </div>
    </div>

    <div
      class="hero-art"
      data-reveal
      style="--reveal-delay:120"
      role="group"
      aria-label="A provisional editorial portrait and coded commerce website concept shown on a laptop and phone"
    >
      <div class="hero-art-grid" aria-hidden="true"></div>
      <div class="hero-index meta" aria-hidden="true">
        LAGOS / 06°31'N / 03°22'E
      </div>
      <figure class="hero-portrait">
        <img
          src="/assets/hero-lab/editorial-portrait.webp"
          width="1200"
          height="1500"
          alt="AI-generated editorial portrait study used as provisional art direction, not a SabiForge employee"
          fetchpriority="high"
        />
        <figcaption class="meta">Editorial image study / provisional</figcaption>
      </figure>
      <div class="hero-laptop" aria-hidden="true">
        <div class="laptop-display">
          <div class="site-nav">
            <strong>kòrà</strong>
            <span>Objects&nbsp;&nbsp; Stories&nbsp;&nbsp; Bag (1)</span>
          </div>
          <div class="site-body">
            <div>
              <small>OBJECTS FOR SLOW LIVING</small>
              <h2>
                Make room
                <br />
                <i>for ritual.</i>
              </h2>
              <span>
                Explore collection <b>↗</b>
              </span>
            </div>
            <div class="site-image">
              <i></i>
              <b></b>
              <small>02 / 06</small>
            </div>
          </div>
        </div>
        <div class="laptop-chin"></div>
      </div>
      <div class="hero-phone" aria-hidden="true">
        <div class="phone-camera"></div>
        <div class="phone-ui">
          <small>Sabi / 09:41</small>
          <strong>S</strong>
          <p>
            Small details,
            <br />
            <i>felt deeply.</i>
          </p>
          <small>Scroll to enter ↓</small>
        </div>
      </div>
      <span class="hero-stamp meta" aria-hidden="true">
        Digital craft
        <br />
        <b>01—03</b>
      </span>
    </div>
  </div>
  <div class="container-page hero-bottom meta" aria-hidden="true">
    <span>Strategy / Art direction / Build</span>
    <span class="hero-rule"></span>
    <span>Built for business. Ready for what’s next.</span>
  </div>
</section>

<style>
  .flagship-hero {
    min-height: min(920px, 100svh);
    padding: 8rem 0 2rem;
    background: var(--color-midnight-900);
    color: var(--color-ivory-100);
  }
  .hero-wash {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(
        circle at 75% 45%,
        color-mix(in srgb, var(--color-mint-300) 14%, transparent),
        transparent 37%
      ),
      radial-gradient(
        circle at 12% 94%,
        color-mix(in srgb, var(--color-midnight-500) 35%, transparent),
        transparent 30%
      );
  }
  .hero-container {
    display: grid;
    min-height: 710px;
    grid-template-columns: 0.92fr 1.08fr;
    align-items: center;
    gap: 2rem;
  }
  .hero-copy {
    position: relative;
    z-index: 3;
    max-width: 42rem;
  }
  .hero-kicker {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    color: var(--color-mint-300);
  }
  .hero-kicker span {
    color: color-mix(in srgb, var(--color-ivory-100) 50%, transparent);
  }
  .hero-copy h1 {
    max-width: 12ch;
    margin-top: 1.6rem;
    font:
      600 clamp(3.2rem, 4.7vw, 5.8rem)/0.9 'Bricolage Grotesque Variable',
      sans-serif;
    letter-spacing: -0.07em;
  }
  .hero-copy h1 em {
    color: var(--color-mint-300);
    font:
      400 1.08em/0.78 'Instrument Serif',
      serif;
    letter-spacing: -0.035em;
  }
  .hero-lede {
    max-width: 32rem;
    margin-top: 2rem;
    color: color-mix(in srgb, var(--color-ivory-100) 72%, transparent);
    font-size: clamp(1rem, 1.2vw, 1.2rem);
    line-height: 1.55;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .hero-note {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    max-width: 24rem;
    margin-top: 3.4rem;
    color: color-mix(in srgb, var(--color-ivory-100) 48%, transparent);
    line-height: 1.45;
  }
  .hero-note span {
    width: 2.5rem;
    margin-top: 0.45rem;
    border-top: 1px solid var(--color-ember);
  }
  .hero-art {
    position: relative;
    min-height: 600px;
    transform: translateX(3vw);
  }
  .hero-art-grid {
    position: absolute;
    inset: 6% 3% 4% 0;
    border: 1px solid color-mix(in srgb, var(--color-mint-300) 28%, transparent);
    clip-path: polygon(0 8%, 88% 0, 100% 88%, 12% 100%);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-mint-300) 6%, transparent),
      transparent 55%
    );
  }
  .hero-art-grid::before,
  .hero-art-grid::after {
    position: absolute;
    inset: 10%;
    border: 1px solid color-mix(in srgb, var(--color-ivory-100) 8%, transparent);
    border-radius: 50%;
    content: '';
  }
  .hero-art-grid::after {
    inset: 20% -5% -5% 20%;
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-ember) 40%, transparent);
  }
  .hero-index {
    position: absolute;
    top: 6%;
    left: 2%;
    color: color-mix(in srgb, var(--color-mint-300) 72%, transparent);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .hero-portrait {
    position: absolute;
    top: 0;
    right: 11%;
    width: 30%;
    min-width: 150px;
    aspect-ratio: 4/5;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-ivory-100) 38%, transparent);
    background: var(--color-midnight-700);
    transform: rotate(4deg);
    box-shadow: 0 2rem 4rem rgb(0 0 0 / 0.3);
  }
  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-portrait figcaption {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.3rem 0.4rem;
    background: var(--color-midnight-950);
    color: var(--color-mint-300);
  }
  .hero-laptop {
    position: absolute;
    z-index: 2;
    bottom: 11%;
    left: 0;
    width: 82%;
    transform: rotate(-5deg);
    filter: drop-shadow(0 2rem 2rem rgb(0 0 0 / 0.35));
  }
  .laptop-display {
    container-type: inline-size;
    aspect-ratio: 16/10;
    overflow: hidden;
    border: 8px solid var(--color-midnight-800);
    border-radius: 0.75rem 0.75rem 0.2rem 0.2rem;
    background: var(--color-ivory-100);
    color: var(--color-ink);
  }
  .laptop-chin {
    height: 0.8rem;
    margin: 0 -5%;
    border-radius: 0 0 50% 50%;
    background: var(--color-midnight-800);
  }
  .site-nav {
    display: flex;
    justify-content: space-between;
    padding: 3% 4%;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    font:
      clamp(0.55rem, 1.2cqi, 0.85rem) 'JetBrains Mono Variable',
      monospace;
  }
  .site-nav strong {
    font: 700 clamp(0.8rem, 2.8cqi, 1.8rem) 'Bricolage Grotesque Variable';
  }
  .site-body {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 4%;
    padding: 8% 6%;
  }
  .site-body small {
    color: var(--color-mint-700);
    font: clamp(0.55rem, 1.4cqi, 0.9rem) 'JetBrains Mono Variable';
    letter-spacing: 0.12em;
  }
  .site-body h2 {
    margin-top: 4%;
    font: 700 clamp(1rem, 6.2cqi, 4rem)/0.9 'Bricolage Grotesque Variable';
    letter-spacing: -0.07em;
  }
  .site-body h2 i,
  .phone-ui p i {
    font: 400 1.12em/0.8 'Instrument Serif';
  }
  .site-body h2 i {
    color: var(--color-mint-700);
  }
  .phone-ui p i {
    color: var(--color-ink);
  }
  .site-body > div > span {
    display: inline-block;
    margin-top: 18%;
    padding: 2.5% 4%;
    background: var(--color-midnight-900);
    color: var(--color-ivory-100);
    font: clamp(0.55rem, 1.4cqi, 0.9rem) 'JetBrains Mono Variable';
  }
  .site-body > div > span b {
    color: var(--color-mint-300);
  }
  .site-image {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background: var(--color-midnight-700);
  }
  .site-image i {
    position: absolute;
    top: 12%;
    right: 8%;
    width: 45%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-ember);
  }
  .site-image b {
    position: absolute;
    bottom: 10%;
    left: 14%;
    width: 64%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle at 35% 30%,
      var(--color-mint-300),
      var(--color-midnight-700) 68%
    );
  }
  .site-image small {
    position: absolute;
    bottom: 5%;
    left: 5%;
    color: var(--color-ivory-100);
  }
  .hero-phone {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: 5%;
    width: 17%;
    min-width: 94px;
    aspect-ratio: 0.48;
    padding: 2%;
    border: 5px solid var(--color-midnight-800);
    border-radius: 1.6rem;
    background: var(--color-midnight-800);
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.3);
    transform: rotate(9deg);
  }
  .phone-camera {
    position: absolute;
    top: 1.5%;
    left: 32%;
    width: 36%;
    height: 2%;
    border-radius: 0 0 1rem 1rem;
    background: var(--color-midnight-950);
  }
  .phone-ui {
    container-type: inline-size;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 12% 9%;
    background: var(--color-ember);
    color: var(--color-ink);
  }
  .phone-ui small {
    font: clamp(0.45rem, 5cqi, 0.75rem) 'JetBrains Mono Variable';
  }
  .phone-ui strong {
    align-self: center;
    margin-top: 35%;
    font: 700 clamp(1.25rem, 28cqi, 3.5rem) 'Bricolage Grotesque Variable';
  }
  .phone-ui p {
    font: 700 clamp(0.7rem, 12cqi, 1.35rem)/0.95 'Bricolage Grotesque Variable';
    letter-spacing: -0.06em;
  }
  .hero-stamp {
    position: absolute;
    right: 3%;
    top: 12%;
    color: color-mix(in srgb, var(--color-ivory-100) 52%, transparent);
    transform: rotate(4deg);
  }
  .hero-stamp b {
    color: var(--color-mint-300);
  }
  .hero-bottom {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: color-mix(in srgb, var(--color-ivory-100) 50%, transparent);
  }
  .hero-rule {
    flex: 1;
    max-width: 18rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ivory-100) 20%, transparent);
  }
  @media (max-width: 900px) {
    .flagship-hero {
      padding-top: 7rem;
    }
    .hero-container {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 0;
    }
    .hero-copy {
      max-width: 38rem;
    }
    .hero-copy h1 {
      font-size: clamp(3rem, 8.5vw, 4.5rem);
    }
    .hero-art {
      min-height: 510px;
      margin-top: -1rem;
      transform: none;
    }
    .hero-bottom {
      margin-top: -1rem;
    }
  }
  @media (max-width: 560px) {
    .flagship-hero {
      min-height: 0;
      padding-bottom: 1rem;
    }
    .hero-copy h1 {
      max-width: 13ch;
      font-size: clamp(2.7rem, 11.5vw, 3.4rem);
    }
    .hero-lede {
      font-size: 1rem;
    }
    .hero-art {
      min-height: 320px;
      margin-top: 0.5rem;
    }
    .hero-portrait {
      right: 10%;
      width: 34%;
      min-width: 105px;
    }
    .hero-laptop {
      bottom: 12%;
      left: -7%;
      width: 94%;
    }
    .hero-phone {
      right: 0;
      bottom: 3%;
      width: 20%;
      min-width: 72px;
      border-width: 4px;
    }
    .hero-index {
      left: -2%;
      font-size: 0.56rem;
    }
    .hero-stamp {
      display: none;
    }
    .hero-bottom {
      margin-top: 0;
      font-size: 0.6rem;
    }
    .hero-bottom span:last-child {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-art * {
      transition: none !important;
    }
  }
</style>
