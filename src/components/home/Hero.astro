---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import HeroVisual from './HeroVisual.astro';
import Skyline from './Skyline.astro';
import { whatsappLink } from '@/data/site';
import { FOUNDING_CLIENT_SLOTS, discountPercentLabel } from '@/lib/pricing';

const highlights = ['Mobile-first builds', 'Naira pricing', 'Training included'];
---

<section
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-32 lg:pt-40 lg:pb-28"
>
  <div class="grid-texture absolute inset-0 -z-20 [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"></div>
  <div
    class="absolute top-[-20%] right-[-10%] -z-10 size-[42rem] rounded-full bg-mint-300/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <Skyline class="absolute right-0 bottom-0 -z-10 h-40 w-full text-mint-300/[0.05] sm:h-56 lg:h-72" />

  <div class="container-page grid items-center gap-16 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
    <div class="animate-rise">
      <a
        href="#pricing"
        class="inline-flex items-center gap-3 rounded-full border border-coral-500/40 bg-coral-500/10 py-1.5 pr-4 pl-1.5 text-xs font-medium text-coral-300 transition hover:border-coral-400 sm:text-sm"
      >
        <span class="rounded-full bg-coral-500 px-2.5 py-1 text-[0.7rem] font-semibold whitespace-nowrap text-midnight-950">
          Founding offer
        </span>
        <span>
          {discountPercentLabel()} off<span class="hidden sm:inline"> for our</span> first{' '}
          {FOUNDING_CLIENT_SLOTS}
          <span class="hidden sm:inline"> eligible</span> clients
        </span>
        <Icon name="arrow-right" class="size-4" />
      </a>

      <h1
        id="hero-title"
        class="mt-7 text-[2.6rem] leading-[1.02] font-semibold text-ivory-50 sm:text-6xl lg:text-[4.4rem]"
      >
        Websites that <span class="text-mint-300">work as hard</span> as{' '}
        <span class="relative whitespace-nowrap text-coral-500">
          your business
          <svg
            viewBox="0 0 300 12"
            class="absolute -bottom-2 left-0 w-full text-coral-500/60"
            aria-hidden="true"
            preserveAspectRatio="none"
          >
            <path
              d="M2 9c60-6 160-8 296-3"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            ></path>
          </svg>
        </span>
        .
      </h1>

      <p class="mt-7 max-w-xl text-lg leading-relaxed text-ivory-100/75">
        SabiForge Digital designs and builds modern business websites, online stores and web
        applications that help Nigerian businesses get found, earn trust and sell online.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={whatsappLink()} external size="lg" icon="whatsapp" iconPosition="start">
          Chat on WhatsApp
        </Button>
        <Button href="#pricing" variant="secondary" size="lg" icon="arrow-right">
          See packages
        </Button>
      </div>

      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-ivory-100/70">
        {highlights.map((item) => (
          <li class="flex items-center gap-2">
            <span class="flex size-5 items-center justify-center rounded-full bg-mint-300/15 text-mint-300">
              <Icon name="check" class="size-3.5" strokeWidth={2.5} />
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="animate-rise [animation-delay:150ms]">
      <HeroVisual />
    </div>
  </div>
</section>
