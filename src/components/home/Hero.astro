---
/**
 * v2 homepage hero, built to docs/references/hero-target-v2.jpeg
 * (owner-supplied, 22 November 2026). Copy and buttons are real HTML; only the
 * laptop-and-phone scene is an image, cut from the reference with its text removed.
 */
import { Picture } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { startProjectHref } from '@/data/site';
import devices from '@/assets/hero/v2-devices.png';
---

<section aria-labelledby="hero-title" class="hero relative isolate overflow-hidden">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container-page hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title" data-reveal>
        Your business deserves more than <em>just a website.</em>
      </h1>
      <p class="hero-lede" data-reveal style="--reveal-delay:100">
        We build professional websites, online stores, and custom software that help businesses
        reach more customers, work smarter, and grow with confidence.
      </p>
      <div class="hero-actions" data-reveal style="--reveal-delay:180">
        <Button href={startProjectHref} size="lg" icon="arrow-right">
          Start your project
        </Button>
        <Button href="/work" variant="secondary" size="lg">
          Explore our work
        </Button>
      </div>
    </div>

    <figure class="hero-visual" data-reveal style="--reveal-delay:120">
      <Picture
        src={devices}
        formats={['avif', 'webp']}
        widths={[480, 738]}
        sizes="(min-width: 1024px) 52vw, 100vw"
        alt="Illustrative concept mockup: a business dashboard on a laptop and a fashion store on a phone"
        loading="eager"
        fetchpriority="high"
        class="hero-image"
      />
      <figcaption class="hero-caption">Concept mockup, not client work</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 7.5rem 0 4rem;
    background: #000417;
    color: var(--color-ivory-100);
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(42% 55% at 78% 48%, rgb(56 189 248 / 0.12), transparent 70%),
      radial-gradient(38% 50% at 92% 88%, rgb(124 58 237 / 0.22), transparent 70%),
      radial-gradient(30% 40% at 8% 10%, rgb(124 58 237 / 0.1), transparent 70%);
  }
  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-title {
    max-width: 16ch;
    font:
      700 clamp(2.6rem, 9vw, 4.6rem)/1.04 var(--font-display),
      sans-serif;
    letter-spacing: -0.035em;
    color: var(--color-ivory-50);
    text-wrap: balance;
  }
  .hero-lede {
    margin-top: 1.5rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 2.6vw, 1.25rem);
    line-height: 1.6;
    color: rgb(214 219 242 / 0.82);
  }
  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .hero-visual {
    position: relative;
    margin: 0 -1.25rem;
  }
  .hero-visual :global(.hero-image) {
    display: block;
    width: 100%;
    height: auto;
    /* Fade the photo's own background into the page on every edge. */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 12%, #000 92%, transparent),
      linear-gradient(to bottom, transparent 0, #000 10%, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0, #000 12%, #000 92%, transparent),
      linear-gradient(to bottom, transparent 0, #000 10%, #000 88%, transparent);
    mask-composite: intersect;
  }
  .hero-caption {
    position: absolute;
    right: 1.25rem;
    bottom: 0.25rem;
    border-radius: 999px;
    border: 1px solid rgb(233 236 251 / 0.14);
    background: rgb(8 11 36 / 0.7);
    padding: 0.25rem 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: rgb(214 219 242 / 0.75);
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 6.5rem 0 4rem;
      min-height: min(820px, 100svh);
      display: flex;
      align-items: center;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
      gap: 1rem;
    }
    .hero-title {
      max-width: 23ch;
      font-size: clamp(2.85rem, 3.85vw, 4rem);
      line-height: 1.08;
    }
    .hero-caption {
      right: 5rem;
    }
    .hero-visual {
      margin: 0 -4rem 0 -2rem;
    }
  }
  @media (min-width: 1536px) {
    .hero-visual {
      margin-right: -6rem;
    }
    .hero-caption {
      right: 7rem;
    }
  }
</style>
