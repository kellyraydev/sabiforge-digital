---
import Button from '@/components/ui/Button.astro';
import ConceptPlate from '@/components/ui/ConceptPlate.astro';
import HexLines from '@/components/ui/HexLines.astro';
import { startProjectHref } from '@/data/site';

const capabilities = [
  {
    id: 'editorial',
    label: 'Brand-led websites',
    concept: 'Àdùn Table',
    kind: 'restaurant website',
  },
  { id: 'commerce', label: 'Commerce', concept: 'Kòrà Home', kind: 'homeware storefront' },
  { id: 'brand', label: 'Brand systems', concept: 'Àdùn Table', kind: 'identity system' },
  { id: 'product', label: 'Product interfaces', concept: 'Tallyhouse', kind: 'invoicing app' },
] as const;
---

<section
  aria-labelledby="hero-title"
  class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-32 lg:pt-36 lg:pb-28"
>
  <div
    class="absolute inset-0 -z-20 bg-[radial-gradient(70%_60%_at_80%_20%,rgb(18_78_71/0.55),transparent),radial-gradient(40%_40%_at_10%_90%,rgb(254_103_79/0.08),transparent)]"
    aria-hidden="true"
  ></div>

  <div class="container-page grid items-center gap-14 lg:grid-cols-[1fr_1.08fr] lg:gap-10">
    <div class="relative z-10">
      <p class="meta flex items-center gap-3 text-mint-300" data-reveal>
        <span aria-hidden="true">(01)</span>
        <span>Design & development studio — Nigeria</span>
      </p>
      <h1 id="hero-title" class="mt-6 text-display-xl font-semibold text-ivory-50">
        Distinctive websites, built to <em class="text-mint-300">do&nbsp;business.</em>
      </h1>
      <p class="text-lede mt-7 max-w-xl text-ivory-100/75">
        SabiForge Digital designs and builds websites, online stores and digital experiences for
        businesses at every stage — from a founder’s first site to an established brand’s redesign.
        Strategy, art direction and careful engineering, sized to what you actually need.
      </p>
      <div
        class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
        data-reveal
        style="--reveal-delay:240"
      >
        <Button href={startProjectHref} size="lg" icon="arrow-up-right">
          Start a project
        </Button>
        <Button href="/work" variant="secondary" size="lg" icon="arrow-right">
          Explore our concepts
        </Button>
      </div>

      <div class="mt-12 lg:mt-16" data-reveal style="--reveal-delay:320">
        <p id="capability-label" class="meta text-ivory-100/60">
          Capabilities — select to preview
        </p>
        <div
          class="mt-3 flex flex-wrap gap-2"
          role="group"
          aria-labelledby="capability-label"
          data-capabilities
        >
          {capabilities.map((cap, index) => (
            <button
              type="button"
              data-capability={cap.id}
              data-concept={cap.concept}
              data-kind={cap.kind}
              aria-pressed={index === 0 ? 'true' : 'false'}
              class="min-h-10 rounded-full border border-ivory-100/15 px-4 text-sm text-ivory-100/80 transition hover:border-mint-300/60 hover:text-ivory-50 aria-pressed:border-mint-300 aria-pressed:bg-mint-300 aria-pressed:text-midnight-900"
            >
              {cap.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <figure class="relative" data-reveal style="--reveal-delay:200">
      <HexLines
        class="absolute top-1/2 left-1/2 -z-10 w-[120%] -translate-x-1/2 -translate-y-1/2 text-mint-300/15"
        rings={7}
      />
      <div
        class="hero-stage relative aspect-[1/1.02] w-full sm:aspect-[1.12/1]"
        data-active="editorial"
      >
        <div class="hero-plate" data-plate="brand" style="--x:52%;--y:0%;--w:48%">
          <ConceptPlate variant="brand" />
        </div>
        <div class="hero-plate" data-plate="editorial" style="--x:0%;--y:8%;--w:68%">
          <ConceptPlate variant="editorial" />
        </div>
        <div class="hero-plate" data-plate="commerce" style="--x:30%;--y:46%;--w:66%">
          <ConceptPlate variant="commerce" />
        </div>
        <div class="hero-plate" data-plate="product" style="--x:4%;--y:42%;--w:27%">
          <ConceptPlate variant="product" />
        </div>
      </div>
      <figcaption class="mt-6 flex items-start gap-3 text-xs text-ivory-100/65 sm:mt-4">
        <span class="meta shrink-0 rounded-full border border-ivory-100/20 px-2 py-0.5 text-ivory-100/80">
          Studio concept
        </span>
        <span aria-live="polite" data-caption>
          Àdùn Table — restaurant website. Fictional brand, not a client project.
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-plate {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    transition:
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.6s ease;
    filter: brightness(0.55) saturate(0.55);
    z-index: 1;
  }
  .hero-plate[data-plate='product'] {
    z-index: 3;
  }
  .hero-plate[data-plate='commerce'] {
    z-index: 2;
  }
  .hero-stage[data-active='editorial'] [data-plate='editorial'],
  .hero-stage[data-active='commerce'] [data-plate='commerce'],
  .hero-stage[data-active='brand'] [data-plate='brand'],
  .hero-stage[data-active='product'] [data-plate='product'] {
    filter: none;
    z-index: 5;
    transform: translateY(-6px) scale(1.03);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-plate {
      transition: none;
    }
  }
</style>

<script>
  const group = document.querySelector<HTMLElement>('[data-capabilities]');
  const stage = document.querySelector<HTMLElement>('.hero-stage');
  const caption = document.querySelector<HTMLElement>('[data-caption]');
  group?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-capability]');
    if (!button || !stage) return;
    group.querySelectorAll('[data-capability]').forEach((el) => {
      el.setAttribute('aria-pressed', String(el === button));
    });
    stage.dataset.active = button.dataset.capability;
    if (caption) {
      caption.textContent = `${button.dataset.concept} — ${button.dataset.kind}. Fictional brand, not a client project.`;
    }
  });
</script>
