---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { benefits } from '@/data/content';
---

<section
  id="why-us"
  aria-labelledby="why-title"
  class="relative overflow-hidden bg-ivory-100 py-24 text-midnight-900 lg:py-32"
>
  <div class="container-page grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
    <div>
      <SectionHeading
        id="why-title"
        tone="dark"
        eyebrow="Why SabiForge"
        title="A website is only worth it if it <span class='text-coral-600'>grows the business</span>."
      >
        We pair clean, modern design with practical decisions for the Nigerian market — so your site
        earns trust quickly and turns visitors into conversations.
      </SectionHeading>

      <div class="mt-10 rounded-[var(--radius-card)] bg-midnight-900 p-7 text-ivory-50">
        <p class="font-display text-xl leading-snug font-medium">
          <em class="not-italic text-mint-300">Sabi</em> means to know. We forge that know-how into
          websites that are simple to manage and built to perform.
        </p>
        <p class="mt-5 text-sm text-ivory-100/60">The idea behind the name.</p>
      </div>
    </div>

    <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
      {benefits.map((benefit, index) => (
        <li class="relative border-t border-midnight-900/15 pt-7">
          <span
            class="absolute top-7 right-0 font-display text-sm font-semibold text-mint-700"
            aria-hidden="true"
          >
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="flex size-12 items-center justify-center rounded-2xl bg-midnight-900 text-mint-300">
            <Icon name={benefit.icon} class="size-6" />
          </span>
          <h3 class="mt-6 text-xl font-semibold">{benefit.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-midnight-800/75">{benefit.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
