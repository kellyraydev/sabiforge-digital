---
import ConceptPlate from '@/components/ui/ConceptPlate.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import { concepts, CONCEPT_LABEL, CONCEPT_DISCLAIMER } from '@/data/concepts';

const [adun, kora, mend, tally] = concepts;
---

<section
  id="work"
  aria-labelledby="work-title"
  class="defer-render relative border-t border-ivory-100/10 bg-midnight-950 py-24 lg:py-36"
>
  <div class="container-page">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHead
        index="03"
        label="Studio concepts"
        id="work-title"
        title="Range, explored <em>honestly</em>."
      >
        <p>
          SabiForge is a new studio. Instead of borrowed logos, here are fictional brands we
          designed to work through real business problems. Each is labelled for exactly what it is.
        </p>
      </SectionHead>
      <p class="meta flex max-w-xs items-start gap-2 text-ivory-100/65 lg:text-right" data-reveal>
        <Icon name="info" class="mt-0.5 size-4 shrink-0 text-mint-300" />
        {CONCEPT_DISCLAIMER}
      </p>
    </div>

    <div class="mt-16 grid gap-y-20 lg:mt-24 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-28">
      {[
        {
          concept: adun,
          plateCols: 'lg:col-span-7',
          textCols: 'lg:col-span-4 lg:col-start-9',
          flip: false,
        },
        {
          concept: kora,
          plateCols: 'lg:col-span-7 lg:col-start-6',
          textCols: 'lg:col-span-4 lg:col-start-1 lg:row-start-auto',
          flip: true,
        },
      ].map(({ concept, plateCols, textCols, flip }, i) => (
        <article
          class="grid gap-8 lg:col-span-12 lg:grid-cols-12 lg:items-center lg:gap-x-10"
          aria-labelledby={`concept-${concept.id}`}
        >
          <div class:list={[plateCols, flip && 'lg:order-2']} data-reveal>
            <ConceptPlate variant={concept.plate} />
          </div>
          <div class:list={[textCols, flip && 'lg:order-1']} data-reveal style="--reveal-delay:120">
            <p class="meta text-mint-300">
              ({String(i + 1).padStart(2, '0')}) {CONCEPT_LABEL} · {concept.category}
            </p>
            <h3
              id={`concept-${concept.id}`}
              class="mt-4 text-display-sm font-semibold text-ivory-50"
            >
              {concept.name}
            </h3>
            <p class="mt-4 leading-relaxed text-ivory-100/75">
              <span class="font-semibold text-ivory-50">The problem. </span>
              {concept.challenge}
            </p>
            <details class="group mt-6 border-t border-ivory-100/12 pt-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm text-sm font-semibold text-ivory-50 marker:hidden hover:text-mint-300 [&::-webkit-details-marker]:hidden">
                Design notes
                <Icon name="plus" class="size-4 transition group-open:rotate-45" />
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ivory-100/75">{concept.approach}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {concept.explores.map((tag) => (
                  <li class="meta rounded-full border border-ivory-100/15 px-3 py-1 text-ivory-100/75">
                    {tag}
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </article>
      ))}

      <div class="grid gap-16 lg:col-span-12 lg:grid-cols-12 lg:gap-10">
        {[
          { concept: mend, cols: 'lg:col-span-7', n: 3 },
          { concept: tally, cols: 'lg:col-span-5', n: 4 },
        ].map(({ concept, cols, n }) => (
          <article
            class:list={[cols, 'flex flex-col']}
            aria-labelledby={`concept-${concept.id}`}
            data-reveal
          >
            <div
              class:list={[
                'flex flex-1 items-end rounded-[var(--radius-card)] bg-midnight-800/60 p-6 sm:p-10',
                concept.plate === 'product' && 'justify-center',
              ]}
            >
              <ConceptPlate
                variant={concept.plate}
                class={concept.plate === 'product' ? 'w-[58%] max-w-72' : 'w-full'}
              />
            </div>
            <p class="meta mt-6 text-mint-300">
              ({String(n).padStart(2, '0')}) {CONCEPT_LABEL} · {concept.category}
            </p>
            <h3
              id={`concept-${concept.id}`}
              class="mt-3 text-display-sm font-semibold text-ivory-50"
            >
              {concept.name}
            </h3>
            <p class="mt-3 leading-relaxed text-ivory-100/75">{concept.challenge}</p>
            <details class="group mt-5 border-t border-ivory-100/12 pt-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm text-sm font-semibold text-ivory-50 hover:text-mint-300 [&::-webkit-details-marker]:hidden">
                Design notes
                <Icon name="plus" class="size-4 transition group-open:rotate-45" />
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ivory-100/75">{concept.approach}</p>
            </details>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
