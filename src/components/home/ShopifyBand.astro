---
import Button from '@/components/ui/Button.astro';
import { whatsappLink } from '@/data/site';

const offers = [
  {
    title: 'Launch a niche store',
    body: 'Complete store setup for your chosen niche — structure, product pages, policies and checkout.',
  },
  {
    title: 'Redesign an existing store',
    body: 'Customise your theme, tidy navigation and make the brand feel premium and trustworthy.',
  },
  {
    title: 'Optimise for sales',
    body: 'Improve speed, product presentation and the path to checkout for a smoother buying experience.',
  },
];
---

<section id="shopify" aria-labelledby="shopify-title" class="py-24 lg:py-32">
  <div class="container-page">
    <div class="relative overflow-hidden rounded-[2rem] bg-[linear-gradient(135deg,#124e47_0%,#0b3a3f_45%,#06292f_100%)] p-7 sm:p-10 lg:p-14">
      <div
        class="absolute -top-24 -right-24 size-80 rounded-full border-[48px] border-mint-300/[0.07]"
        aria-hidden="true"
      ></div>
      <div class="relative grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
        <div>
          <p class="eyebrow">Shopify & dropshipping</p>
          <h2
            id="shopify-title"
            class="mt-4 text-3xl leading-[1.1] font-semibold text-ivory-50 sm:text-4xl lg:text-5xl"
          >
            Starting a store — or ready to <span class="text-mint-300">level one up?</span>
          </h2>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-ivory-100/75">
            Whether you are launching your first dropshipping business or already run a Shopify
            store, we help you look credible and sell with less friction.
          </p>
          <div class="mt-8">
            <Button
              href={whatsappLink("Hello SabiForge Digital, I'd like help with a Shopify store.")}
              external
              icon="arrow-right"
            >
              Talk about your store
            </Button>
          </div>
          <p class="mt-6 text-xs text-ivory-100/60">
            Shopify is a trademark of Shopify Inc. SabiForge Digital is an independent studio.
          </p>
        </div>

        <ol class="grid gap-4">
          {offers.map((offer, index) => (
            <li class="flex gap-5 rounded-2xl border border-ivory-100/10 bg-midnight-950/40 p-5 backdrop-blur-sm sm:p-6">
              <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-mint-300 font-display font-bold text-midnight-900">
                {index + 1}
              </span>
              <div>
                <h3 class="text-lg font-semibold text-ivory-50">{offer.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-ivory-100/70">{offer.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
