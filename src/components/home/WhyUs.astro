---
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import { differentiators } from '@/data/home';
---

<section
  id="why"
  aria-labelledby="why-title"
  class="defer-render on-paper relative bg-ivory-100 py-24 text-midnight-900 lg:py-36"
>
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-end">
      <SectionHead
        index="06"
        label="Why SabiForge"
        id="why-title"
        tone="paper"
        title="What working with us <em class='text-coral-700'>feels</em> like."
      />
      <p class="text-lede max-w-xl text-midnight-800/80 lg:justify-self-end" data-reveal>
        No inflated claims or invented awards. Here is what you can expect from the way we work, and
        why it matters to your business.
      </p>
    </div>

    <ul class="mt-16 grid gap-x-10 sm:grid-cols-2 xl:grid-cols-4">
      {differentiators.map((item, index) => (
        <li
          class="flex flex-col border-t border-midnight-900/15 py-8"
          data-reveal
          style={`--reveal-delay:${(index % 4) * 70}`}
        >
          <div class="flex items-center justify-between">
            <span class="flex size-11 items-center justify-center rounded-full bg-midnight-900 text-mint-300">
              <Icon name={item.icon} class="size-5" />
            </span>
            <span class="meta text-midnight-800/70" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
          </div>
          <h3 class="mt-6 text-xl leading-snug font-semibold">{item.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-midnight-800/80">{item.benefit}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
