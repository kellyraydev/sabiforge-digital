---
import Icon from '@/components/ui/Icon.astro';
import { audiences } from '@/data/home';
---

<section aria-labelledby="audience-title" class="relative bg-[#000417] pb-6">
  <div class="container-page">
    <div class="grid gap-6 rounded-2xl border border-ivory-100/10 bg-midnight-800/50 px-6 py-6 backdrop-blur sm:grid-cols-2 lg:grid-cols-[1.2fr_repeat(4,1fr)] lg:items-center lg:gap-0 lg:px-8">
      <h2
        id="audience-title"
        class="font-display text-lg font-semibold leading-snug text-ivory-50 sm:col-span-2 lg:col-span-1 lg:pr-6"
      >
        Built for growing businesses like yours.
      </h2>
      <ul class="contents">
        {audiences.map((audience) => (
          <li class="flex items-center gap-3 text-sm text-ivory-100/85 lg:border-l lg:border-ivory-100/10 lg:px-6">
            <Icon name={audience.icon} class="size-7 shrink-0 text-coral-300" />
            {audience.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
