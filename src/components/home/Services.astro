---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { services } from '@/data/content';
import { whatsappLink } from '@/data/site';

const [lead, ...rest] = services;
---

<section id="services" aria-labelledby="services-title" class="relative py-24 lg:py-32">
  <div class="container-page">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="services-title"
        eyebrow="What we build"
        title="Everything your business needs to <span class='text-mint-300'>sell online</span>."
      >
        From a sharp one-page site to a full online store or custom web app — designed, built and
        supported by one accountable team.
      </SectionHeading>
      <a
        href="#pricing"
        class="group inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-mint-300 hover:text-mint-200"
      >
        Compare packages
        <Icon name="arrow-right" class="size-4 transition group-hover:translate-x-1" />
      </a>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <li
        id={lead.id}
        class="relative flex flex-col overflow-hidden rounded-[var(--radius-card)] bg-mint-300 p-7 text-midnight-900 sm:col-span-2"
      >
        <div
          class="absolute -top-16 -right-16 size-56 rounded-full border-[28px] border-midnight-900/[0.06]"
          aria-hidden="true"
        ></div>
        <span class="flex size-12 items-center justify-center rounded-2xl bg-midnight-900 text-mint-300">
          <Icon name={lead.icon} class="size-6" />
        </span>
        <h3 class="mt-8 text-3xl font-semibold sm:text-4xl">{lead.title}</h3>
        <p class="mt-4 max-w-md text-base leading-relaxed text-midnight-900/75">
          {lead.summary} The fastest way to look established, get found on Google and make it easy
          for customers to reach you.
        </p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {lead.points.map((point) => (
            <li class="rounded-full bg-midnight-900/10 px-3 py-1.5 text-xs font-semibold">
              {point}
            </li>
          ))}
        </ul>
        <div class="mt-auto pt-8">
          <a
            href={whatsappLink("Hello SabiForge Digital, I'm interested in a business website.")}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center gap-2 rounded-full bg-midnight-900 px-5 text-sm font-semibold text-ivory-50 transition hover:bg-midnight-700"
          >
            Discuss your website
            <Icon name="arrow-right" class="size-4" />
            <span class="sr-only">(opens WhatsApp in a new tab)</span>
          </a>
        </div>
      </li>

      {rest.map((service) => (
        <li
          id={service.id}
          class="group relative flex flex-col rounded-[var(--radius-card)] border border-ivory-100/10 bg-midnight-800/60 p-6 transition duration-300 hover:-translate-y-1 hover:border-mint-300/40 hover:bg-midnight-800"
        >
          <span class="flex size-11 items-center justify-center rounded-xl bg-mint-300/10 text-mint-300 transition group-hover:bg-mint-300 group-hover:text-midnight-900">
            <Icon name={service.icon} class="size-5" />
          </span>
          <h3 class="mt-6 text-xl font-semibold text-ivory-50">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ivory-100/65">{service.summary}</p>
          <ul class="mt-5 space-y-1.5 border-t border-ivory-100/10 pt-4 text-xs text-ivory-100/60">
            {service.points.map((point) => (
              <li class="flex items-center gap-2">
                <span class="size-1 rounded-full bg-coral-500" aria-hidden="true" />
                {point}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
