---
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import PathwaySelector, { type PathwayOption } from './PathwaySelector';
import { publicPathways } from '@/data/home';
import {
  approvedServices,
  publicServiceFamilies,
  servicesInFamily,
  serviceHref,
} from '@/data/services';

const families = publicServiceFamilies();
const options: PathwayOption[] = publicPathways().map((p) => ({
  id: p.id,
  label: p.label,
  situation: p.situation,
  recommendation: p.recommendation,
  packageHint: p.packageHint,
  services: p.services.map((slug) => {
    const service = approvedServices.find((item) => item.slug === slug);
    if (!service) throw new Error(`Pathway linked a service that is not public: ${slug}`);
    return { name: service.name, href: serviceHref(slug) };
  }),
}));
---

<section
  id="services"
  aria-labelledby="services-title"
  class="defer-render on-paper relative bg-ivory-100 py-24 text-midnight-900 lg:py-36"
>
  <div class="container-page">
    <SectionHead
      index="04"
      label="Services"
      id="services-title"
      tone="paper"
      title="Four services. Two areas of <em class='text-coral-700'>expertise.</em>"
    >
      <p>One studio for the website or store, and for looking after it once it is live.</p>
    </SectionHead>

    <div
      class:list={[
        'mt-16 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-midnight-900/12 bg-midnight-900/12',
        families.length > 2 ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
      ]}
    >
      {families.map((family, fi) => (
        <div
          class="flex flex-col bg-ivory-50 p-7 sm:p-9"
          data-reveal
          style={`--reveal-delay:${fi * 90}`}
        >
          <p class="meta text-mint-800">({String(fi + 1).padStart(2, '0')})</p>
          <h3 class="mt-3 text-display-sm font-semibold">{family.name}</h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-midnight-800/80">
            {family.description}
          </p>
          <ul class="mt-8 border-t border-midnight-900/12">
            {servicesInFamily(family.id).map((service) => (
              <li class="border-b border-midnight-900/12">
                <a
                  href={serviceHref(service.slug)}
                  class="group flex items-start justify-between gap-4 rounded-sm py-4"
                >
                  <span>
                    <span class="block font-semibold text-midnight-900 group-hover:text-mint-800">
                      {service.name}
                    </span>
                    <span class="mt-1 block text-sm leading-relaxed text-midnight-800/75">
                      {service.summary.split('. ')[0].replace(/\.$/, '')}.
                    </span>
                  </span>
                  <Icon
                    name="arrow-up-right"
                    class="mt-1 size-4 shrink-0 text-midnight-900/50 transition group-hover:text-midnight-900"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-20 lg:mt-28">
      <PathwaySelector client:visible options={options} />
    </div>

    <p class="mt-12 text-center">
      <a
        href="/services"
        class="inline-flex items-center gap-2 rounded-sm font-semibold text-midnight-900 underline decoration-midnight-900/30 underline-offset-[6px] hover:decoration-midnight-900"
      >
        Browse all services <Icon name="arrow-right" class="size-4" />
      </a>
    </p>
  </div>
</section>
