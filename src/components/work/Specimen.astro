---
/** Palette, type roles, limits and related services for a concept: the "spec sheet". */
import type { Concept } from '@/data/concepts';
import { approvedServices, serviceHref } from '@/data/services';

interface Props {
  concept: Concept;
}
const { concept } = Astro.props;
const { theme, palette, type, limits, services: relatedSlugs } = concept.study;
const related = relatedSlugs
  .map((slug) => approvedServices.find((service) => service.slug === slug))
  .filter((service) => service !== undefined);
const line = `border-color:${theme.fg}33`;
---

<div class="grid gap-10 md:grid-cols-2" data-reveal>
  <div>
    <h3 class="meta" style={`color:${theme.accent}`}>
      Palette
    </h3>
    <ul class="mt-4 flex flex-wrap gap-3">
      {palette.map((c) => (
        <li class="w-[4.5rem]">
          <span
            class="block aspect-square rounded-lg border"
            style={`background:${c.hex};${line}`}
            aria-hidden="true"
          />
          <span class="mt-2 block text-sm font-semibold">{c.name}</span>
          <span class="meta block" style={`color:${theme.muted}`}>
            {c.hex}
          </span>
        </li>
      ))}
    </ul>
    <h3 class="meta mt-8" style={`color:${theme.accent}`}>
      Typography
    </h3>
    <dl class="mt-3 divide-y text-sm" style={`--tw-divide-color:${theme.fg}33`}>
      {type.map((t) => (
        <div class="flex justify-between gap-6 border-t py-2" style={line}>
          <dt style={`color:${theme.muted}`}>{t.role}</dt>
          <dd class="text-right font-medium">{t.face}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div>
    <h3 class="meta" style={`color:${theme.accent}`}>
      What this concept can’t show
    </h3>
    <p class="mt-3 leading-relaxed" style={`color:${theme.muted}`}>
      {limits}
    </p>
    <h3 class="meta mt-8" style={`color:${theme.accent}`}>
      Related services
    </h3>
    <ul class="mt-3 space-y-2">
      {related.map((s) => {
        return (
          <li>
            <a href={serviceHref(s.slug)} class="link-sweep font-semibold">
              {s.name}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</div>
