---
/**
 * Coded interface plates for SabiForge studio concepts (fictional brands).
 * Everything scales with container-query units (cqw), so a plate renders
 * proportionally at any width. Decorative: always pair with a visible
 * caption that labels the concept as fictional.
 */
import type { PlateVariant } from '@/data/concepts';

interface Props {
  variant: PlateVariant;
  class?: string;
}
const { variant, class: className } = Astro.props;
const descriptions: Record<PlateVariant, string> = {
  editorial:
    'Interface concept: restaurant homepage for the fictional brand Àdùn Table, with an editorial headline, menu list and event button.',
  commerce:
    'Interface concept: product page for the fictional homeware brand Kòrà Home, showing a patterned throw, price, colour and size options.',
  service:
    'Interface concept: physiotherapy clinic homepage for the fictional Mend Physio Studio, with condition cards and appointment times.',
  product:
    'Interface concept: mobile invoicing dashboard for the fictional app Tallyhouse, showing amount outstanding and invoices needing attention.',
  brand:
    'Interface concept: identity system board for the fictional brand Àdùn Table, with logo, typography and colour swatches.',
};
const patternId = `adire-${Math.random().toString(36).slice(2, 8)}`;

const adunMenu = [
  ['Smoked jollof, party style', '₦6,500'],
  ['Ofada stew & plantain', '₦7,200'],
  ['Suya-spiced short rib', '₦12,000'],
];
const tallyRows = [
  ['INV-0142', 'Bello Prints', '₦185,000', 'Overdue'],
  ['INV-0141', 'Ada & Co.', '₦92,500', 'Paid'],
  ['INV-0140', 'Okafor Logistics', '₦310,000', 'Sent'],
];
---

<div
  class:list={['@container select-none', className]}
  role="img"
  aria-label={descriptions[variant]}
>
  {variant === 'editorial' && (
    <div class="overflow-hidden rounded-[var(--radius-plate)] bg-[#f6efe4] text-[#2a1a14] shadow-[0_40px_80px_-40px_rgb(0_0_0/0.8)]">
      <div class="flex items-center justify-between border-b border-[#2a1a14]/10 px-[4cqw] py-[2.6cqw] text-[2.1cqw]">
        <span class="font-serif text-[3.4cqw] tracking-wide">Àdùn Table</span>
        <span class="flex gap-[3cqw] opacity-70">
          <span>Menu</span>
          <span>Catering</span>
          <span>Visit</span>
        </span>
      </div>
      <div class="grid grid-cols-[1.15fr_1fr] gap-[4cqw] p-[4cqw]">
        <div>
          <p class="font-mono text-[1.8cqw] tracking-[0.2em] text-[#9a4220] uppercase">
            Lagos · Kitchen & events
          </p>
          <p class="mt-[2cqw] font-serif text-[7.2cqw] leading-[0.95]">
            Food worth <em class="text-[#9a4220]">gathering</em> for.
          </p>
          <div class="mt-[4cqw] space-y-[1.6cqw] text-[2.1cqw]">
            {adunMenu.map(([dish, price]) => (
              <div class="flex items-end gap-[1.2cqw]">
                <span>{dish}</span>
                <span class="mb-[0.5cqw] flex-1 border-b border-dotted border-[#2a1a14]/30" />
                <span class="font-semibold">{price}</span>
              </div>
            ))}
          </div>
          <span class="mt-[4cqw] inline-flex rounded-full bg-[#2a1a14] px-[3cqw] py-[1.4cqw] text-[2cqw] text-[#f6efe4]">
            Plan an event →
          </span>
        </div>
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2cqw] bg-[#b4532a]">
          <div class="absolute inset-[12%] rounded-full bg-[#f6efe4]/95" />
          <div class="absolute inset-[22%] rounded-full bg-[radial-gradient(circle_at_40%_35%,#e8a24a,#c4561f_55%,#7d2d12)]" />
          <div class="absolute top-[30%] left-[34%] size-[9%] rounded-full bg-[#3f6b2a]" />
          <div class="absolute top-[52%] left-[56%] size-[7%] rounded-full bg-[#f6efe4]/90" />
          <div class="absolute right-[8%] bottom-[6%] h-[30%] w-[5%] rotate-[24deg] rounded-full bg-[#2a1a14]/80" />
        </div>
      </div>
    </div>
  )}

  {variant === 'commerce' && (
    <div class="overflow-hidden rounded-[var(--radius-plate)] bg-[#efe7da] text-[#1d2240] shadow-[0_40px_80px_-40px_rgb(0_0_0/0.8)]">
      <div class="flex items-center justify-between px-[4cqw] py-[2.6cqw] text-[2.1cqw]">
        <span class="font-display text-[3.4cqw] font-bold tracking-tight">kòrà</span>
        <span class="flex gap-[3cqw] opacity-70">
          <span>Bedroom</span>
          <span>Living</span>
          <span>Bag (1)</span>
        </span>
      </div>
      <div class="grid grid-cols-[1.1fr_1fr] gap-[4cqw] px-[4cqw] pb-[4cqw]">
        <div class="relative aspect-square overflow-hidden rounded-[2cqw] bg-[#23305e]">
          <svg viewBox="0 0 100 100" class="absolute inset-0 size-full opacity-60">
            <defs>
              <pattern id={patternId} width="20" height="20" patternUnits="userSpaceOnUse">
                <circle cx="10" cy="10" r="6" fill="none" stroke="#efe7da" stroke-width="1.2" />
                <circle cx="10" cy="10" r="2" fill="#efe7da" />
                <path d="M0 0l20 20M20 0 0 20" stroke="#efe7da" stroke-width=".4" />
              </pattern>
            </defs>
            <rect width="100" height="100" fill={`url(#${patternId})`} />
          </svg>
          <span class="absolute bottom-[4cqw] left-[4cqw] rounded-full bg-[#efe7da] px-[2cqw] py-[0.8cqw] text-[1.8cqw]">
            Hand-dyed
          </span>
        </div>
        <div class="flex flex-col">
          <p class="font-mono text-[1.7cqw] tracking-[0.15em] uppercase opacity-80">Throws</p>
          <p class="mt-[1cqw] text-[4.4cqw] leading-tight font-semibold">Ọ̀run Throw</p>
          <p class="mt-[1cqw] text-[3cqw] font-semibold">₦38,000</p>
          <p class="mt-[3cqw] text-[1.8cqw] opacity-70">Colour · Indigo</p>
          <div class="mt-[1.2cqw] flex gap-[1.4cqw]">
            <span class="size-[4.4cqw] rounded-full bg-[#23305e] ring-2 ring-[#1d2240] ring-offset-2 ring-offset-[#efe7da]" />
            <span class="size-[4.4cqw] rounded-full bg-[#b36b2c]" />
            <span class="size-[4.4cqw] rounded-full bg-[#5f6f52]" />
          </div>
          <p class="mt-[3cqw] text-[1.8cqw] opacity-70">Size</p>
          <div class="mt-[1.2cqw] flex gap-[1.4cqw] text-[1.9cqw]">
            <span class="rounded-[1cqw] border border-[#1d2240] px-[2cqw] py-[0.8cqw]">Single</span>
            <span class="rounded-[1cqw] border border-[#1d2240]/25 px-[2cqw] py-[0.8cqw]">
              Double
            </span>
          </div>
          <span class="mt-auto flex justify-center rounded-full bg-[#d79a2b] py-[1.8cqw] text-[2.2cqw] font-semibold">
            Add to bag
          </span>
        </div>
      </div>
    </div>
  )}

  {variant === 'service' && (
    <div class="overflow-hidden rounded-[var(--radius-plate)] bg-[#e4ece6] text-[#173a31] shadow-[0_40px_80px_-40px_rgb(0_0_0/0.8)]">
      <div class="flex items-center justify-between px-[4cqw] py-[2.6cqw] text-[2.1cqw]">
        <span class="text-[3.2cqw] font-semibold">
          mend<span class="text-[#d9774a]">.</span>
        </span>
        <span class="rounded-full bg-[#173a31] px-[2.6cqw] py-[1cqw] text-[1.9cqw] text-[#e4ece6]">
          Request appointment
        </span>
      </div>
      <div class="px-[4cqw] pb-[4cqw]">
        <p class="text-[6.6cqw] leading-[1] font-semibold tracking-tight">
          Move without
          <br />
          pain again.
        </p>
        <p class="mt-[2cqw] max-w-[70%] text-[2.1cqw] opacity-75">
          Plain-language guidance and a clear first visit, so you know what to expect.
        </p>
        <div class="mt-[4cqw] grid grid-cols-3 gap-[2cqw] text-[2cqw]">
          {['Back & neck', 'Sports injury', 'After surgery'].map((item, i) => (
            <div
              class:list={[
                'rounded-[1.6cqw] p-[2.4cqw]',
                i === 0 ? 'bg-[#173a31] text-[#e4ece6]' : 'bg-white/70',
              ]}
            >
              <span class="block size-[3.6cqw] rounded-full border-[0.5cqw] border-current opacity-70" />
              <span class="mt-[2cqw] block font-semibold">{item}</span>
              <span class="block opacity-70">What to expect →</span>
            </div>
          ))}
        </div>
        <div class="mt-[3cqw] flex items-center gap-[1.4cqw] text-[1.8cqw]">
          <span class="opacity-70">Next openings:</span>
          {['Tue 10:00', 'Wed 14:30', 'Fri 09:00'].map((slot, i) => (
            <span
              class:list={[
                'rounded-full px-[1.8cqw] py-[0.8cqw]',
                i === 1 ? 'bg-[#e8956d] text-[#0f2a23]' : 'border border-[#173a31]/30',
              ]}
            >
              {slot}
            </span>
          ))}
        </div>
      </div>
    </div>
  )}

  {variant === 'product' && (
    <div class="mx-auto w-full rounded-[7cqw] bg-[#0b1020] p-[2.4cqw] shadow-[0_40px_80px_-30px_rgb(0_0_0/0.9)]">
      <div class="overflow-hidden rounded-[5.4cqw] bg-[#f4f6fb] text-[#14213d]">
        <div class="flex items-center justify-between px-[6cqw] pt-[6cqw] text-[4cqw]">
          <span class="font-semibold">Today</span>
          <span class="size-[8cqw] rounded-full bg-[#c6f36b]" />
        </div>
        <div class="mx-[5cqw] mt-[4cqw] rounded-[4cqw] bg-[#14213d] p-[5cqw] text-[#f4f6fb]">
          <p class="text-[3.6cqw] opacity-70">Outstanding</p>
          <p class="mt-[1cqw] text-[9cqw] leading-none font-semibold tracking-tight">₦587,500</p>
          <div class="mt-[4cqw] flex h-[12cqw] items-end gap-[2cqw]">
            {[40, 65, 35, 80, 55, 90, 70].map((h, i) => (
              <span
                class:list={['flex-1 rounded-[1cqw]', i === 5 ? 'bg-[#c6f36b]' : 'bg-white/25']}
                style={`height:${h}%`}
              />
            ))}
          </div>
        </div>
        <p class="px-[6cqw] pt-[5cqw] text-[3.6cqw] font-semibold">Needs attention</p>
        <div class="space-y-[2cqw] px-[5cqw] pt-[2cqw] pb-[6cqw]">
          {tallyRows.map(([id, client, amount, status]) => (
            <div class="flex items-center justify-between rounded-[3cqw] bg-white px-[4cqw] py-[3cqw] text-[3.3cqw]">
              <span>
                <span class="block font-semibold">{client}</span>
                <span class="block opacity-80">{id}</span>
              </span>
              <span class="text-right">
                <span class="block font-semibold">{amount}</span>
                <span
                  class:list={[
                    'mt-[0.6cqw] inline-block rounded-full px-[2cqw] text-[2.8cqw]',
                    status === 'Overdue' && 'bg-[#ffe1d9] text-[#a3301f]',
                    status === 'Paid' && 'bg-[#e2f7c4] text-[#3b5a0c]',
                    status === 'Sent' && 'bg-[#e3e8f5] text-[#14213d]',
                  ]}
                >
                  {status}
                </span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {variant === 'brand' && (
    <div class="overflow-hidden rounded-[var(--radius-plate)] bg-[#fbf7f0] p-[4cqw] text-[#2a1a14] shadow-[0_40px_80px_-40px_rgb(0_0_0/0.8)]">
      <div class="flex items-center justify-between font-mono text-[1.8cqw] tracking-[0.12em] uppercase opacity-80">
        <span>Àdùn Table · Identity system</span>
        <span>v1.0</span>
      </div>
      <div class="mt-[3cqw] grid grid-cols-[1fr_1.4fr] gap-[3cqw]">
        <div class="flex aspect-square items-center justify-center rounded-[2cqw] bg-[#b4532a]">
          <span class="flex size-[60%] items-center justify-center rounded-full border-[0.6cqw] border-[#f6efe4] font-serif text-[13cqw] text-[#f6efe4] italic">
            À
          </span>
        </div>
        <div class="grid grid-rows-[1fr_auto] gap-[2cqw]">
          <div class="rounded-[2cqw] border border-[#2a1a14]/10 p-[2.6cqw]">
            <p class="font-serif text-[9cqw] leading-none">Aa</p>
            <p class="mt-[1cqw] text-[1.9cqw] opacity-70">Display serif · Grotesk text</p>
          </div>
          <div class="grid grid-cols-4 gap-[1.4cqw]">
            {['#2a1a14', '#b4532a', '#e8a24a', '#3f6b2a'].map((c) => (
              <div>
                <div class="aspect-square rounded-[1.4cqw]" style={`background:${c}`} />
                <p class="mt-[0.8cqw] font-mono text-[1.5cqw] opacity-70">{c}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="mt-[3cqw] grid grid-cols-3 gap-[2cqw] text-[1.9cqw]">
        <div class="rounded-[2cqw] bg-[#2a1a14] p-[2.4cqw] text-[#f6efe4]">
          <p class="font-serif text-[3.6cqw] leading-tight">Sunday family table</p>
          <p class="mt-[1cqw] opacity-70">Social template</p>
        </div>
        <div class="rounded-[2cqw] border border-[#2a1a14]/15 p-[2.4cqw]">
          <p class="font-semibold">Clear space</p>
          <div class="mt-[1.4cqw] flex aspect-[2/1] items-center justify-center rounded-[1cqw] border border-dashed border-[#b4532a]">
            <span class="font-serif text-[4cqw] italic">À</span>
          </div>
        </div>
        <div class="rounded-[2cqw] bg-[#e8a24a] p-[2.4cqw]">
          <p class="font-semibold">Tone</p>
          <p class="mt-[1cqw]">Warm, generous, unhurried.</p>
        </div>
      </div>
    </div>
  )}
</div>
