---
/**
 * An image position that can ship before its picture exists.
 * With `image`, renders an optimised <Picture>. Without it, renders a designed
 * gradient placeholder (decorative) and records the slot id so it can be listed in
 * docs/IMAGE-REQUESTS.md and replaced later without layout changes.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconKey } from '@/lib/icons';

interface Props {
  slot: string;
  image?: ImageMetadata;
  alt: string;
  icon?: IconKey;
  widths?: number[];
  sizes?: string;
  class?: string;
  /** Aspect ratio of the frame, e.g. "4 / 3". */
  ratio?: string;
  position?: string;
}
const {
  slot,
  image,
  alt,
  icon = 'sparkle',
  widths = [320, 640],
  sizes = '(min-width: 1024px) 25vw, 50vw',
  class: className,
  ratio = '4 / 3',
  position = 'center',
} = Astro.props;
---

<div
  class:list={['image-slot relative overflow-hidden', className]}
  style={`aspect-ratio:${ratio}`}
  data-image-slot={slot}
  data-image-state={image ? 'final' : 'placeholder'}
>
  {image ? (
    <Picture
      src={image}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      alt={alt}
      class="size-full object-cover"
      style={`object-position:${position}`}
    />
  ) : (
    <div class="placeholder size-full" aria-hidden="true">
      <span class="placeholder-grid" />
      <span class="placeholder-icon">
        <Icon name={icon} class="size-7" />
      </span>
    </div>
  )}
</div>

<style>
  .placeholder {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(70% 90% at 80% 10%, rgb(124 58 237 / 0.45), transparent 70%),
      radial-gradient(60% 80% at 10% 100%, rgb(34 211 238 / 0.25), transparent 70%),
      linear-gradient(160deg, #141a46, #0a0e2c);
  }
  .placeholder-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(233 236 251 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(233 236 251 / 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(70% 70% at 50% 50%, #000, transparent);
  }
  .placeholder-icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    border: 1px solid rgb(233 236 251 / 0.18);
    background: rgb(8 11 36 / 0.55);
    color: #c4b5fd;
    backdrop-filter: blur(6px);
  }
</style>
