---
/**
 * Architectural line work built from the logo's 30°/60° hexagon geometry.
 * Decorative only.
 */
interface Props {
  class?: string;
  /** Number of hex rings. */
  rings?: number;
}
const { class: className, rings = 6 } = Astro.props;
const cx = 200;
const cy = 200;
const hex = (r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI / 3) * i - Math.PI / 2;
    return `${(cx + r * Math.cos(a)).toFixed(1)},${(cy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const radii = Array.from({ length: rings }, (_, i) => 30 + i * 30);
const spokes = Array.from({ length: 6 }, (_, i) => {
  const a = (Math.PI / 3) * i - Math.PI / 2;
  const r = radii[radii.length - 1];
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
---

<svg
  viewBox="0 0 400 400"
  class={className}
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {radii.map((r, i) => (
    <polygon
      points={hex(r)}
      stroke-width={i === radii.length - 1 ? 1.2 : 0.7}
      stroke-dasharray={i % 2 ? '2 6' : undefined}
    />
  ))}
  {spokes.map((p) => (
    <line x1={cx} y1={cy} x2={p.x.toFixed(1)} y2={p.y.toFixed(1)} stroke-width="0.6" />
  ))}
</svg>
