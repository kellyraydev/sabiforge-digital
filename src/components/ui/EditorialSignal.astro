---
interface Props {
  variant?:
    'work' | 'studio' | 'services' | 'pricing' | 'contact' | 'process' | 'commerce' | 'service';
  label?: string;
}

const { variant = 'work', label = 'SabiForge Digital visual study' } = Astro.props;
---

<div
  class:list={['editorial-signal', `editorial-signal-${variant}`]}
  aria-label={label}
  role="img"
  data-reveal
>
  <div class="signal-grid" aria-hidden="true"></div>
  <div class="signal-window signal-window-back" aria-hidden="true">
    <span class="signal-window-top">
      <i></i>
      <i></i>
      <i></i>
      <b>studio / signal</b>
    </span>
    <span class="signal-window-line"></span>
    <span class="signal-window-line short"></span>
    <span class="signal-window-block"></span>
  </div>
  <div class="signal-window signal-window-front" aria-hidden="true">
    <span class="signal-window-top">
      <i></i>
      <i></i>
      <i></i>
      <b>
        {variant === 'pricing' ? 'scope / 04' : variant === 'contact' ? 'brief / 01' : 'index / 01'}
      </b>
    </span>
    <span class="signal-display">
      {variant === 'work'
        ? '01—04'
        : variant === 'studio'
          ? 'SABI'
          : variant === 'services'
            ? '10'
            : variant === 'pricing'
              ? '₦'
              : variant === 'contact'
                ? '→'
                : variant === 'process'
                  ? '06'
                  : variant === 'commerce'
                    ? 'Bag'
                    : '01'}
    </span>
    <span class="signal-caption">
      {variant === 'work'
        ? 'Concepts / Interfaces / Systems'
        : variant === 'studio'
          ? 'Know properly. Make deliberately.'
          : variant === 'services'
            ? 'Strategy · Build · Growth'
            : variant === 'pricing'
              ? 'Right-sized work'
              : variant === 'contact'
                ? 'A considered beginning'
                : variant === 'process'
                  ? 'Decisions stay yours'
                  : variant === 'commerce'
                    ? 'Browse / choose / buy'
                    : 'Useful, specific, considered'}
    </span>
  </div>
  <span class="signal-orbit signal-orbit-a" aria-hidden="true"></span>
  <span class="signal-orbit signal-orbit-b" aria-hidden="true"></span>
  <span class="signal-index meta" aria-hidden="true">
    LAGOS / 06°31'N / 03°22'E
  </span>
</div>

<style>
  .editorial-signal {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgb(46 230 196 / 0.24);
    background: linear-gradient(135deg, #11163a, #0a0e2c 65%, #2a1f6b);
    color: #e9ecfb;
    clip-path: polygon(0 0, 93% 0, 100% 7%, 100% 100%, 7% 100%, 0 93%);
  }
  .signal-grid {
    position: absolute;
    inset: -20%;
    z-index: -1;
    opacity: 0.45;
    background-image:
      linear-gradient(rgb(46 230 196 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(46 230 196 / 0.12) 1px, transparent 1px);
    background-size: 3.2rem 3.2rem;
    transform: rotate(-12deg);
  }
  .signal-window {
    position: absolute;
    width: 62%;
    aspect-ratio: 1.25;
    padding: 0.7rem;
    border: 1px solid rgb(233 236 251 / 0.22);
    background: #e9ecfb;
    color: #0a0e2c;
    box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 0.2);
  }
  .signal-window-back {
    top: 17%;
    left: 8%;
    opacity: 0.55;
    transform: rotate(-9deg);
  }
  .signal-window-front {
    right: 8%;
    bottom: 12%;
    z-index: 2;
    transform: rotate(4deg);
  }
  .signal-window-top {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    border-bottom: 1px solid rgb(10 14 44 / 0.16);
    padding-bottom: 0.45rem;
    font: 0.52rem/1 var(--font-mono);
  }
  .signal-window-top i {
    display: block;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: #a78bfa;
  }
  .signal-window-top i:nth-child(2) {
    background: #2ee6c4;
  }
  .signal-window-top i:nth-child(3) {
    background: #0a0e2c;
  }
  .signal-window-top b {
    margin-left: auto;
    font-weight: 500;
    opacity: 1;
  }
  .signal-window-line {
    display: block;
    width: 72%;
    height: 0.42rem;
    margin-top: 1.4rem;
    background: #2a1f6b;
  }
  .signal-window-line.short {
    width: 44%;
    margin-top: 0.4rem;
    background: #a78bfa;
  }
  .signal-window-block {
    display: block;
    width: 42%;
    height: 3.2rem;
    margin-top: 1.2rem;
    background: #2ee6c4;
  }
  .signal-display {
    display: block;
    margin-top: 11%;
    color: #2a1f6b;
    font: 700 clamp(2.2rem, 7vw, 5rem)/0.9 var(--font-display);
    letter-spacing: -0.08em;
  }
  .signal-caption {
    display: block;
    max-width: 10rem;
    margin-top: 0.8rem;
    color: #6d28d9;
    font: 0.56rem/1.35 var(--font-mono);
  }
  .signal-orbit {
    position: absolute;
    border: 1px solid rgb(167 139 250 / 0.55);
    border-radius: 50%;
  }
  .signal-orbit-a {
    width: 18rem;
    height: 18rem;
    right: -5rem;
    top: -6rem;
  }
  .signal-orbit-b {
    width: 25rem;
    height: 25rem;
    left: -12rem;
    bottom: -15rem;
    border-style: dashed;
    border-color: rgb(46 230 196 / 0.4);
  }
  .signal-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: rgb(46 230 196 / 0.72);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .editorial-signal-studio .signal-display {
    color: #6d28d9;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }
  .editorial-signal-services .signal-window-front {
    background: #2ee6c4;
  }
  .editorial-signal-services .signal-caption {
    color: #0a0e2c;
  }
  .editorial-signal-pricing .signal-display {
    color: #a78bfa;
  }
  .editorial-signal-contact .signal-window-front {
    background: #a78bfa;
  }
  .editorial-signal-contact .signal-display {
    color: #0a0e2c;
  }
  .editorial-signal-contact .signal-caption {
    color: #0a0e2c;
  }
  .editorial-signal-process .signal-window-front {
    background: #2a1f6b;
    color: #e9ecfb;
  }
  .editorial-signal-process .signal-window-top {
    border-color: rgb(233 236 251 / 0.2);
  }
  .editorial-signal-process .signal-display {
    color: #2ee6c4;
  }
  .editorial-signal-process .signal-caption {
    color: #2ee6c4;
  }
  .editorial-signal-commerce .signal-window-front {
    background: #e9ecfb;
  }
  @media (max-width: 640px) {
    .editorial-signal {
      min-height: 17rem;
    }
    .signal-window {
      width: 68%;
    }
    .signal-display {
      font-size: 3rem;
    }
    .signal-index {
      font-size: 0.56rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .editorial-signal * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
