---
import LogoMark from './LogoMark.astro';

interface Props {
  class?: string;
  /** Use the dark wordmark on light surfaces. */
  tone?: 'light' | 'dark';
}
const { class: className = '', tone = 'light' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <LogoMark class="h-9 w-auto shrink-0 sm:h-10" />
  <span
    class:list={['h-8 w-px', tone === 'light' ? 'bg-ivory-100/30' : 'bg-midnight-900/25']}
    aria-hidden="true"
  ></span>
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        'font-display text-[1.15rem] font-bold tracking-[0.02em] sm:text-xl',
        tone === 'light' ? 'text-ivory-50' : 'text-midnight-900',
      ]}
    >
      SABIFORGE
    </span>
    <span
      class:list={[
        'font-display mt-1 text-[0.62rem] font-medium tracking-[0.55em] sm:text-[0.68rem]',
        tone === 'light' ? 'text-mint-300' : 'text-mint-700',
      ]}
    >
      DIGITAL
    </span>
  </span>
</span>
