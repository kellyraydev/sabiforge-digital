---
import { icons, type IconKey } from '@/lib/icons';

interface Props {
  name: IconKey;
  class?: string;
  strokeWidth?: number;
  label?: string;
}
const { name, class: className = 'size-5', strokeWidth = 1.75, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icons[name]}
/>
