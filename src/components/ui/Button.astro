---
import Icon from './Icon.astro';
import type { IconKey } from '@/lib/icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ink' | 'outline-ink' | 'link';
  size?: 'md' | 'lg';
  icon?: IconKey;
  iconPosition?: 'start' | 'end';
  external?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  external = false,
  class: className,
  ...rest
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2.5 font-semibold transition duration-200 active:scale-[0.98]';
const variants = {
  // White on violet-600 is 5.7:1 (WCAG AA). Lighter violets fail with white text.
  primary:
    'rounded-full bg-coral-600 text-white shadow-[0_0_1.75rem_-0.4rem_rgb(124_58_237/0.7)] hover:bg-coral-700',
  secondary:
    'rounded-full border border-ivory-100/25 text-ivory-50 hover:border-mint-300 hover:text-mint-200',
  ink: 'rounded-full bg-midnight-900 text-ivory-50 hover:bg-midnight-700',
  'outline-ink':
    'rounded-full border border-midnight-900/40 text-midnight-900 hover:border-midnight-900 hover:bg-midnight-900/5',
  link: 'rounded-sm text-mint-300 underline decoration-mint-300/40 underline-offset-[6px] hover:decoration-mint-300',
};
const sizes = {
  md: variant === 'link' ? 'text-sm' : 'min-h-11 px-5 text-sm',
  lg: variant === 'link' ? 'text-base' : 'min-h-13 px-7 text-base',
};
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} class="size-[1.15em]" />}
  <slot />
  {icon && iconPosition === 'end' && (
    <Icon
      name={icon}
      class="size-[1.15em] transition-transform duration-200 group-hover:translate-x-0.5"
    />
  )}
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>
