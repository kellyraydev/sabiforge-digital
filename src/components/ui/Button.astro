---
import Icon from './Icon.astro';
import type { IconKey } from '@/lib/icons';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'md' | 'lg';
  icon?: IconKey;
  iconPosition?: 'start' | 'end';
  external?: boolean;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  external = false,
  class: className,
  ...rest
} = Astro.props;

const variants = {
  primary:
    'bg-coral-500 text-midnight-950 shadow-[0_12px_30px_-12px_rgb(254_103_79/0.7)] hover:bg-coral-400',
  secondary: 'border border-mint-300/40 text-mint-100 hover:border-mint-300 hover:bg-mint-300/10',
  ghost: 'text-ivory-100 hover:text-mint-300',
  dark: 'bg-midnight-900 text-ivory-50 hover:bg-midnight-700',
};
const sizes = {
  md: 'h-11 px-5 text-sm',
  lg: 'h-13 px-7 text-base',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition duration-200 active:scale-[0.98]',
    variants[variant],
    sizes[size],
    className,
  ]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} class="size-5" />}
  <slot />
  {icon && iconPosition === 'end' && (
    <Icon name={icon} class="size-5 transition-transform group-hover:translate-x-0.5" />
  )}
  {external && <span class="sr-only">(opens in a new tab)</span>}
</a>
