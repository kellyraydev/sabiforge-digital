---
import Logo from '@/components/ui/Logo.astro';
import Button from '@/components/ui/Button.astro';
import MobileNav from './MobileNav';
import { navigation, site, startProjectHref, whatsappLink } from '@/data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = navigation.map((item) => ({
  ...item,
  current: Boolean(
    item.match &&
    (item.match === '/' ? path === '/' : path === item.match || path.startsWith(`${item.match}/`)),
  ),
}));
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[transform,background-color,border-color] duration-300 ease-out data-[hidden=true]:-translate-y-full data-[scrolled=true]:border-b data-[scrolled=true]:border-ivory-100/10 data-[scrolled=true]:bg-midnight-950/85 data-[scrolled=true]:backdrop-blur-xl"
>
  <div class="container-page flex h-18 items-center justify-between gap-6 lg:h-20">
    <a href="/" class="relative z-50 shrink-0 rounded-md">
      <Logo />
      <span class="sr-only">, home</span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 xl:gap-1">
        {items
          .filter((item) => item.primary)
          .map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.current ? 'page' : undefined}
                class="relative block rounded-md px-3 py-2 text-sm font-medium text-ivory-100/80 transition after:absolute after:inset-x-3 after:-bottom-0.5 after:h-0.5 after:rounded-full after:bg-coral-400 after:opacity-0 after:transition hover:text-ivory-50 aria-[current=page]:text-ivory-50 aria-[current=page]:after:opacity-100 xl:px-3.5"
              >
                {item.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <Button
        href={whatsappLink()}
        variant="secondary"
        icon="chat"
        iconPosition="start"
        external
        class="hidden xl:inline-flex"
      >
        Talk to us
      </Button>
      <Button href={startProjectHref} icon="arrow-right">
        Start your project
      </Button>
    </div>

    <MobileNav
      client:media="(max-width: 1023px)"
      items={items}
      ctaHref={startProjectHref}
      whatsappHref={whatsappLink()}
      email={site.contact.email}
      phoneDisplay={site.contact.whatsappDisplay}
      phoneHref={site.contact.phoneHref}
    />
  </div>
</header>

<script>
  // Smart header: solid after scrolling, hides on scroll down, returns on scroll up.
  // Never hides while focus is inside it or near the top of the page.
  const header = document.getElementById('site-header');
  let lastY = window.scrollY;
  let ticking = false;
  const update = () => {
    const y = window.scrollY;
    const focusInside = header?.contains(document.activeElement);
    const menuOpen = document.documentElement.dataset.menuOpen === 'true';
    header?.setAttribute('data-scrolled', String(y > 12));
    const hide = y > 320 && y > lastY + 4 && !focusInside && !menuOpen;
    if (hide) header?.setAttribute('data-hidden', 'true');
    else if (y < lastY - 4 || y <= 320 || focusInside || menuOpen)
      header?.setAttribute('data-hidden', 'false');
    lastY = y;
    ticking = false;
  };
  update();
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  header?.addEventListener('focusin', () => header.setAttribute('data-hidden', 'false'));
</script>
