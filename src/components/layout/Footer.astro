---
import LogoMark from '@/components/ui/LogoMark.astro';
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import HexLines from '@/components/ui/HexLines.astro';
import { navigation, site, whatsappLink, mailtoLink, startProjectHref } from '@/data/site';
import { serviceFamilies, servicesInFamily, serviceHref } from '@/data/services';

interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="relative isolate overflow-hidden border-t border-ivory-100/10 bg-midnight-950">
  <HexLines class="absolute -top-40 -right-40 -z-10 size-[44rem] text-mint-300/[0.07]" rings={7} />

  <div class="container-page pt-20 pb-10 lg:pt-28">
    {showCta && (
      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-end">
        <p class="font-display text-display-md font-semibold text-ivory-50">
          Built for business. <em class="text-mint-300">Ready</em> for what’s next.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
          <a
            href={startProjectHref}
            class="group inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-coral-500 px-7 font-semibold text-midnight-950 transition hover:bg-coral-400"
          >
            Start a project
            <Icon name="arrow-up-right" class="size-5 transition group-hover:translate-x-0.5" />
          </a>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-ivory-100/25 px-7 font-semibold text-ivory-50 transition hover:border-mint-300"
          >
            <Icon name="whatsapp" class="size-5" /> WhatsApp
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    )}

    <div
      class:list={[
        'grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_repeat(5,1fr)]',
        showCta && 'mt-16 border-t border-ivory-100/10 pt-12',
      ]}
    >
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block rounded-md">
          <Logo />
          <span class="sr-only">, home</span>
        </a>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-ivory-100/70">
          A design and development studio for businesses in {site.market}, at every stage of growth.
        </p>
      </div>

      <nav aria-labelledby="footer-studio">
        <h2 id="footer-studio" class="meta text-mint-300">
          Studio
        </h2>
        <ul class="mt-5 space-y-3 text-sm">
          {navigation.map((item) => (
            <li>
              <a class="text-ivory-100/75 transition hover:text-ivory-50" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {serviceFamilies.map((family) => (
        <nav aria-labelledby={`footer-${family.id}`}>
          <h2 id={`footer-${family.id}`} class="meta text-mint-300">
            {family.name}
          </h2>
          <ul class="mt-5 space-y-3 text-sm">
            {servicesInFamily(family.id).map((service) => (
              <li>
                <a
                  class="text-ivory-100/75 transition hover:text-ivory-50"
                  href={serviceHref(service.slug)}
                >
                  {service.shortName}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div>
        <h2 class="meta text-mint-300">Contact</h2>
        <ul class="mt-5 space-y-3 text-sm">
          <li>
            <a
              class="text-ivory-100/75 transition hover:text-ivory-50"
              href={site.contact.phoneHref}
            >
              {site.contact.whatsappDisplay}
            </a>
          </li>
          <li>
            <a
              class="break-all text-ivory-100/75 transition hover:text-ivory-50"
              href={mailtoLink()}
            >
              {site.contact.email}
            </a>
          </li>
          {site.social.map((profile) => (
            <li>
              <a
                class="text-ivory-100/75 hover:text-ivory-50"
                href={profile.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {profile.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-xs leading-relaxed text-ivory-100/60">
          Working with businesses across Nigeria, remotely and on WhatsApp.
        </p>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-ivory-100/10 pt-6 text-xs text-ivory-100/60 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-3">
        <LogoMark class="h-5 w-auto" />
        &copy; {year} {site.name}
      </p>
      <p>Prices in Nigerian naira. Third-party costs are quoted separately.</p>
      <p class="flex gap-4">
        <a href="/privacy" class="rounded-sm hover:text-ivory-50">
          Privacy (draft)
        </a>
        <a href="/terms" class="rounded-sm hover:text-ivory-50">
          Terms (draft)
        </a>
      </p>
      <a href="#main" class="inline-flex items-center gap-1.5 rounded-sm hover:text-ivory-50">
        Back to top <Icon name="arrow-up-right" class="size-3.5 -rotate-45" />
      </a>
    </div>
  </div>
</footer>
