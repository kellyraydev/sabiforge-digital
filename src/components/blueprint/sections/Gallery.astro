---
import ImageSlot from '@/components/blueprint/ImageSlot.astro';
import type { Section } from '@/lib/blueprint';
interface Props {
  slug: string;
  name: string;
  section: Extract<Section, { type: 'gallery' }>;
}
const { slug, name, section } = Astro.props;
---

<section class="bp-section">
  {section.title && (
    <h2 class="bp-section-title" data-reveal>
      {section.title}
    </h2>
  )}
  <div class="bp-gallery">
    {section.images.map((img, i) => (
      <div class="bp-gallery-item" data-reveal style={`--bp-reveal-index:${i % 4}`}>
        <ImageSlot
          slug={slug}
          image={img}
          projectName={name}
          ratio={i % 3 === 0 ? '4 / 5' : '1 / 1'}
        />
      </div>
    ))}
  </div>
</section>
<style>
  .bp-gallery {
    margin-top: var(--bp-space-block);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--bp-gallery-gap);
    align-items: start;
  }
  .bp-gallery > :nth-child(even) {
    margin-top: var(--bp-gallery-shift-sm);
  }
  .bp-gallery-item :global(.bp-img) {
    transition:
      transform var(--bp-motion-hover) var(--bp-ease),
      box-shadow var(--bp-motion-hover) var(--bp-ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bp-gallery-item:hover :global(.bp-img) {
      transform: translateY(-6px);
      box-shadow: var(--bp-shadow-lift);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-gallery-item:hover :global(.bp-img) {
      transform: none;
      box-shadow: none;
    }
  }
  @media (min-width: 800px) {
    .bp-gallery {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--bp-space-inline);
      row-gap: var(--bp-gallery-gap);
    }
    .bp-gallery > :nth-child(even) {
      margin-top: 0;
    }
    .bp-gallery > :nth-child(6n + 1) {
      grid-column: 1 / span 7;
    }
    .bp-gallery > :nth-child(6n + 2) {
      grid-column: 8 / span 5;
      margin-top: var(--bp-gallery-shift);
    }
    .bp-gallery > :nth-child(6n + 3) {
      grid-column: 1 / span 5;
    }
    .bp-gallery > :nth-child(6n + 4) {
      grid-column: 6 / span 7;
      margin-top: calc(var(--bp-gallery-shift) * 0.4);
    }
    .bp-gallery > :nth-child(6n + 5) {
      grid-column: 1 / span 6;
    }
    .bp-gallery > :nth-child(6n + 6) {
      grid-column: 7 / span 6;
      margin-top: var(--bp-gallery-shift);
    }
  }
</style>
