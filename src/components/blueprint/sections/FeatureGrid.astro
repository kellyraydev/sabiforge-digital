---
import type { Section } from '@/lib/blueprint';
interface Props {
  section: Extract<Section, { type: 'feature-grid' }>;
}
const { section } = Astro.props;
---

<section class="bp-section">
  {section.title && (
    <h2 class="bp-section-title" data-reveal>
      {section.title}
    </h2>
  )}
  {section.intro && (
    <p class="bp-section-intro" data-reveal style="--bp-reveal-index: 1">
      {section.intro}
    </p>
  )}
  <ul class="bp-feature-grid" role="list">
    {section.items.map((item, i) => (
      <li class="bp-card" data-reveal style={`--bp-reveal-index:${i % 4}`}>
        <h3 class="bp-card-title">{item.title}</h3>
        <p class="bp-card-body">{item.body}</p>
      </li>
    ))}
  </ul>
</section>
<style>
  .bp-feature-grid {
    list-style: none;
    margin: var(--bp-space-block) 0 0;
    padding: 0;
    display: grid;
    gap: var(--bp-space-inline);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .bp-card {
    background: var(--bp-surface);
    border-radius: var(--bp-radius);
    padding: var(--bp-space-card);
    border: 1px solid color-mix(in srgb, var(--bp-ink) 10%, transparent);
    transition:
      transform var(--bp-motion-fast) var(--bp-ease),
      border-color var(--bp-motion-fast) var(--bp-ease),
      box-shadow var(--bp-motion-fast) var(--bp-ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bp-card:hover {
      transform: translateY(-4px);
      border-color: color-mix(in srgb, var(--bp-accent) 42%, transparent);
      box-shadow: var(--bp-shadow-lift);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
  .bp-card-title {
    font-family: var(--bp-display);
    font-weight: 400;
    font-size: var(--bp-type-card);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .bp-card-body {
    margin: 0.7rem 0 0;
    color: var(--bp-muted);
    font-size: var(--bp-type-body);
    line-height: var(--bp-leading-body);
  }
</style>
