---
import ImageSlot from '@/components/blueprint/ImageSlot.astro';
import type { Section } from '@/lib/blueprint';
interface Props {
  slug: string;
  name: string;
  section: Extract<Section, { type: 'hero' }>;
}
const { slug, name, section } = Astro.props;
const href = (to: string) => (to.startsWith('/') ? `/preview/${slug}${to === '/' ? '' : to}` : to);
---

<section class="bp-hero" data-reveal>
  <div class="bp-hero-copy">
    {section.eyebrow && <p class="bp-eyebrow">{section.eyebrow}</p>}
    <h1 class="bp-hero-title">{section.headline}</h1>
    {section.sub && <p class="bp-hero-sub">{section.sub}</p>}
    {(section.cta || section.secondaryCta) && (
      <div class="bp-hero-actions">
        {section.cta && (
          <a class="bp-btn bp-btn-primary" href={href(section.cta.to)}>
            {section.cta.label}
          </a>
        )}
        {section.secondaryCta && (
          <a class="bp-btn bp-btn-ghost" href={href(section.secondaryCta.to)}>
            {section.secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
  <ImageSlot
    slug={slug}
    image={section.image}
    projectName={name}
    ratio="4 / 5"
    class="bp-hero-img"
  />
</section>
<style>
  .bp-hero {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding: clamp(3rem, 8vw, 7rem) 0 clamp(3.5rem, 8vw, 7.5rem);
  }
  @media (min-width: 900px) {
    .bp-hero {
      grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    }
  }
  .bp-hero-title {
    font-family: var(--bp-display);
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    line-height: 0.99;
    letter-spacing: -0.055em;
    max-width: 11ch;
    margin: 0.65rem 0 0;
  }
  .bp-hero-sub {
    margin: 1.35rem 0 0;
    max-width: 42ch;
    color: var(--bp-muted);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
  }
  .bp-hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .bp-hero-img {
    box-shadow: 0 1.5rem 4rem color-mix(in srgb, var(--bp-ink) 12%, transparent);
  }
</style>
