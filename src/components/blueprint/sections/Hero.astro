---
import ImageSlot from '@/components/blueprint/ImageSlot.astro';
import type { Section } from '@/lib/blueprint';
interface Props {
  slug: string;
  name: string;
  section: Extract<Section, { type: 'hero' }>;
}
const { slug, name, section } = Astro.props;
const href = (to: string) => (to.startsWith('/') ? `/preview/${slug}${to === '/' ? '' : to}` : to);
---

<section class="bp-hero">
  <div class="bp-hero-copy" data-reveal style="--bp-reveal-index: 0">
    {section.eyebrow && <p class="bp-eyebrow">{section.eyebrow}</p>}
    <h1 class="bp-hero-title">{section.headline}</h1>
    {section.sub && <p class="bp-hero-sub">{section.sub}</p>}
    {(section.cta || section.secondaryCta) && (
      <div class="bp-hero-actions">
        {section.cta && (
          <a class="bp-btn bp-btn-primary" href={href(section.cta.to)}>
            {section.cta.label}
          </a>
        )}
        {section.secondaryCta && (
          <a class="bp-btn bp-btn-ghost" href={href(section.secondaryCta.to)}>
            {section.secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
  <div class="bp-hero-frame" data-reveal style="--bp-reveal-index: 1">
    <ImageSlot
      slug={slug}
      image={section.image}
      projectName={name}
      ratio="4 / 5"
      class="bp-hero-img"
    />
  </div>
</section>
<style>
  .bp-hero {
    display: grid;
    gap: var(--bp-space-hero-gap);
    align-items: center;
    padding: var(--bp-space-hero-y) 0 calc(var(--bp-space-hero-y) + 0.5rem);
  }
  @media (min-width: 900px) {
    .bp-hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.9fr);
    }
  }
  .bp-hero-title {
    font-family: var(--bp-display);
    font-size: var(--bp-type-hero);
    font-weight: 400;
    line-height: var(--bp-leading-display);
    letter-spacing: var(--bp-track-display);
    max-width: 11ch;
    margin: 0.7rem 0 0;
    text-wrap: balance;
  }
  .bp-hero-sub {
    margin: 1.35rem 0 0;
    max-width: 38ch;
    color: var(--bp-muted);
    font-size: var(--bp-type-lede);
    line-height: var(--bp-leading-body);
  }
  .bp-hero-actions {
    margin-top: 2.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .bp-hero-frame {
    position: relative;
    isolation: isolate;
  }
  .bp-hero-frame::before {
    content: '';
    position: absolute;
    z-index: -1;
    right: 7%;
    bottom: -0.85rem;
    left: 14%;
    height: 68%;
    border-radius: var(--bp-radius);
    background: color-mix(in srgb, var(--bp-accent) 16%, var(--bp-surface));
  }
  .bp-hero-frame :global(.bp-img) {
    box-shadow: var(--bp-shadow-lift);
    transition:
      transform var(--bp-motion-hover) var(--bp-ease),
      box-shadow var(--bp-motion-hover) var(--bp-ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bp-hero-frame:hover :global(.bp-img) {
      transform: translateY(-6px);
      box-shadow: 0 1.6rem 3rem color-mix(in srgb, var(--bp-ink) 16%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-hero-frame:hover :global(.bp-img) {
      transform: none;
      box-shadow: var(--bp-shadow-lift);
    }
  }
</style>
