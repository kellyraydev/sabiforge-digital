---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { site } from '@/data/site';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Additional JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
  /** Hide the footer's project CTA (e.g. on the contact page itself). */
  footerCta?: boolean;
  /** Show a reading-progress bar (long pages). */
  progress?: boolean;
}

const {
  title,
  description = site.description,
  structuredData = [],
  noindex = false,
  footerCta = true,
  progress = false,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Design & development studio`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${canonical.origin}/#organization`,
  name: site.name,
  slogan: site.tagline,
  description: site.description,
  url: canonical.origin,
  email: site.contact.email,
  telephone: `+${site.contact.whatsappNumber}`,
  areaServed: { '@type': 'Country', name: 'Nigeria' },
  currenciesAccepted: 'NGN',
};
---

<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#031f25" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={new URL('/assets/og-sabiforge.png', Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/assets/og-sabiforge.png', Astro.site)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#main"
      class="fixed top-3 left-3 z-[70] -translate-y-24 rounded-full bg-mint-300 px-5 py-3 font-semibold text-midnight-900 transition focus:translate-y-0"
    >
      Skip to content
    </a>
    {progress && <div class="scroll-progress" aria-hidden="true"></div>}
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer showCta={footerCta} />

    <script>
      // Reveal-on-enter. Content is visible without JS and with reduced motion.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
