---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import CtaPanel from '@/components/page/CtaPanel.astro';
import Decisions from '@/components/work/Decisions.astro';
import Specimen from '@/components/work/Specimen.astro';
import CaseStudies from '@/components/home/CaseStudies.astro';
import { concepts, TECHNOLOGY_POSITIONING } from '@/data/concepts';
import { conceptImage } from '@/data/concept-media';

const num = (index: number) => String(index + 1).padStart(2, '0');
import { getDemo } from '@/data/demos';
import { approvedServices } from '@/data/services';

const serviceNames = (slugs: string[]) =>
  slugs
    .map((slug) => approvedServices.find((service) => service.slug === slug)?.shortName)
    .filter(Boolean)
    .join(', ');
---

<BaseLayout
  footerCta={false}
  title="Work: concept projects"
  description="Ten concept projects by SabiForge Digital. Seven are invented brands. Three are uncommissioned concepts based on existing businesses. None is client work."
  ogImage="/assets/work-og.jpg"
  progress
>
  <section class="relative isolate overflow-hidden pt-32 pb-20 lg:pt-44 lg:pb-28">
    <div
      class="absolute inset-0 -z-20 bg-[radial-gradient(55%_70%_at_90%_0%,rgb(91_33_182/0.55),transparent),radial-gradient(35%_45%_at_0%_100%,rgb(46_230_196/0.08),transparent)]"
      aria-hidden="true"
    ></div>
    <div class="container-page">
      <Breadcrumbs items={[{ label: 'Work' }]} />
      <div class="mt-10 grid gap-14 lg:grid-cols-[1.25fr_1fr] lg:items-end">
        <div>
          <p class="meta text-mint-300">Work · Concept projects</p>
          <h1 class="mt-5 text-display-xl font-semibold text-ivory-50">
            Ten concept projects. One <em class="text-mint-300">register</em>.
          </h1>
          <p class="text-lede mt-8 max-w-xl text-ivory-100/75">{TECHNOLOGY_POSITIONING}</p>
          <p class="mt-5 max-w-xl text-ivory-100/75">
            The interfaces in these studies are coded pages, photographed into distinct scenes.
            Published prices, scopes and post-launch support stay on the services and pricing pages.
          </p>
        </div>
        <aside
          class="chamfer border border-ivory-100/15 bg-midnight-800/70 p-6 sm:p-8"
          aria-label="About this work"
        >
          <p class="meta flex items-center gap-2 text-coral-400">
            <Icon name="info" class="size-4" /> Read this first
          </p>
          <p class="mt-3 text-ivory-50">
            Seven studies invent a brand. Big Beerah Collection, Amzlat World of Beauty and Opeyemi
            Phones &amp; Gadgets are uncommissioned design concepts based on existing businesses.
            None of these pages is commissioned client work, an official website, or a verified
            result.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-ivory-100/75">
            <li>No testimonials or business results appear on this page.</li>
            <li>Sample tasks and device options are layout material.</li>
            <li>Prices, warranties, stock and contact numbers are not shown.</li>
          </ul>
        </aside>
      </div>

      <nav aria-label="Concepts" class="mt-16 lg:mt-24">
        <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {concepts.map((concept, index) => (
            <li>
              <a
                href={`#${concept.id}`}
                class="group flex h-full flex-col justify-between gap-8 rounded-2xl border p-5 transition duration-300 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                style={`background:${concept.study.theme.bg};color:${concept.study.theme.fg};border-color:${concept.study.theme.fg}33`}
              >
                <span class="meta" style={`color:${concept.study.theme.accent}`}>
                  ({num(index)}) {concept.label}
                </span>
                <span>
                  <span class="block font-display text-xl leading-tight font-semibold">
                    {concept.name}
                  </span>
                  <span class="mt-1 block text-sm" style={`color:${concept.study.theme.muted}`}>
                    {concept.category}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>
  <!-- Filterable overview of all ten concepts (moved from the v1 homepage, 22 Nov 2026). -->
  <CaseStudies />

  {concepts.map((concept, index) => (
    <article
      id={concept.id}
      class="scroll-mt-28 border-t border-ivory-100/10 py-20 lg:py-28"
      style={`background:${concept.study.theme.bg};color:${concept.study.theme.fg}`}
      aria-labelledby={`${concept.id}-title`}
    >
      <div class="container-page">
        <p class="meta" style={`color:${concept.study.theme.accent}`}>
          ({num(index)}) {concept.label} · {concept.category}
        </p>
        <h2
          id={`${concept.id}-title`}
          class="mt-4 max-w-3xl text-display-lg font-semibold"
          set:html={concept.study.headline}
        />
        <p
          class="mt-6 max-w-2xl text-lg leading-relaxed"
          style={`color:${concept.study.theme.muted}`}
        >
          {concept.summary} {concept.study.brief}
        </p>
        <dl
          class="mt-8 grid max-w-4xl gap-x-8 gap-y-4 border-y py-5 text-sm sm:grid-cols-2 lg:grid-cols-4"
          style={`border-color:${concept.study.theme.fg}26`}
          data-study-meta
        >
          {[
            ['Sector', concept.category],
            ['Concept', concept.study.capability],
            ['Service', serviceNames(concept.study.services)],
            [
              'Basis',
              concept.basis === 'reference'
                ? 'Existing business, uncommissioned'
                : 'Invented brand',
            ],
          ].map(([term, value]) => (
            <div>
              <dt class="meta" style={`color:${concept.study.theme.accent}`}>
                {term}
              </dt>
              <dd class="mt-1 font-medium">{value}</dd>
            </div>
          ))}
        </dl>
        {getDemo(concept.id) && (
          <div class="mt-6 flex flex-wrap gap-3" data-demo-links>
            <a
              href={`/work/${concept.id}/demo`}
              class="inline-flex min-h-11 items-center gap-2 rounded-full px-5 text-sm font-semibold"
              style={`background:${concept.study.theme.fg};color:${concept.study.theme.bg}`}
            >
              View the interactive demo
            </a>
            <a
              href={`/work/${concept.id}/demo?review=1`}
              class="inline-flex min-h-11 items-center gap-2 rounded-full border px-5 text-sm font-semibold"
              style={`border-color:${concept.study.theme.muted};color:${concept.study.theme.fg}`}
            >
              Review the concept
            </a>
          </div>
        )}
        <Image
          src={conceptImage(concept.id, 'detail-hero')}
          alt={concept.alt.detail}
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 1280px) 1120px, 100vw"
          class="mt-10 aspect-video w-full rounded-[var(--radius-card)] object-cover"
        />
        <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_.6fr] lg:items-start">
          <figure>
            <Image
              src={conceptImage(concept.id, 'desktop-ui')}
              alt={concept.alt.desktop}
              widths={[720, 1100, 1440]}
              sizes="(min-width: 1024px) 65vw, 100vw"
              class="w-full rounded-2xl border border-white/10"
            />
            <figcaption class="mt-3 text-sm" style={`color:${concept.study.theme.muted}`}>
              Desktop interface, coded for this concept.
            </figcaption>
          </figure>
          <figure>
            <Image
              src={conceptImage(concept.id, 'mobile-ui')}
              alt={concept.alt.mobile}
              widths={[390, 780]}
              sizes="(min-width: 1024px) 280px, 70vw"
              class="mx-auto w-full max-w-xs rounded-2xl border border-white/10"
            />
            <figcaption class="mt-3 text-sm" style={`color:${concept.study.theme.muted}`}>
              The same interface at a phone width.
            </figcaption>
          </figure>
        </div>
        <div class="mt-14">
          <h3 class="meta" style={`color:${concept.study.theme.accent}`}>
            How the concept came together
          </h3>
          <ol class="mt-5 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-study-steps>
            {[
              ['Challenge', concept.challenge],
              ['Audience', concept.study.audience],
              ['Direction', concept.approach],
              [
                'Interface',
                'Coded desktop and phone pages, shown above, built to the same palette and type as the spec below.',
              ],
            ].map(([title, body], step) => (
              <li class="border-t pt-4" style={`border-color:${concept.study.theme.fg}33`}>
                <p class="meta" style={`color:${concept.study.theme.accent}`}>
                  {num(step)}
                </p>
                <p class="mt-1 font-display text-lg font-semibold">{title}</p>
                <p
                  class="mt-2 text-sm leading-relaxed"
                  style={`color:${concept.study.theme.muted}`}
                >
                  {body}
                </p>
              </li>
            ))}
          </ol>
        </div>
        <div class="mt-12">
          <Decisions concept={concept} columns />
        </div>
        <div class="mt-12">
          <Specimen concept={concept} />
        </div>
        <div
          class="mt-14 flex flex-col gap-6 border-t pt-8 sm:flex-row sm:items-center sm:justify-between"
          style={`border-color:${concept.study.theme.fg}26`}
        >
          <ul class="flex flex-wrap gap-2" aria-label={`${concept.name} topics`} data-study-tags>
            {concept.explores.map((tag) => (
              <li
                class="rounded-full border px-3 py-1 text-xs font-semibold"
                style={`border-color:${concept.study.theme.fg}40`}
              >
                {tag}
              </li>
            ))}
          </ul>
          {(() => {
            const next = concepts[(index + 1) % concepts.length];
            return (
              <a
                href={`#${next.id}`}
                class="group inline-flex shrink-0 items-center gap-3 font-semibold"
                data-next-concept
              >
                <span class="meta" style={`color:${concept.study.theme.accent}`}>
                  Next concept
                </span>
                <span>{next.name}</span>
                <Icon name="arrow-right" class="size-4 transition group-hover:translate-x-1" />
              </a>
            );
          })()}
        </div>
      </div>
    </article>
  ))}

  <section
    aria-labelledby="client-work-title"
    class="border-t border-ivory-100/10 bg-midnight-950 py-20 text-ivory-50 lg:py-28"
  >
    <div class="container-page grid gap-8 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-20">
      <p class="meta text-mint-300">Client work</p>
      <div>
        <h2 id="client-work-title" class="text-display-md font-semibold">
          Not yet. <em class="text-mint-300">Honestly.</em>
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-ivory-100/75">
          No client projects are published here yet. When SabiForge completes work that clients are
          happy to show, it will appear in its own section, with their permission and without
          invented numbers.
        </p>
      </div>
    </div>
  </section>

  <CtaPanel
    title="Have a problem like <em>one</em> of these?"
    body="Tell us about your business and what your customers struggle with. We’ll say how we’d approach it, and whether you need a studio yet."
    whatsappMessage="Hello SabiForge Digital, I saw your concept projects and I'd like to discuss a project."
  />
</BaseLayout>
