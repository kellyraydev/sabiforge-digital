---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import CaseStudies from '@/components/home/CaseStudies.astro';
import Services from '@/components/home/Services.astro';
import Approach from '@/components/home/Approach.astro';
import Engagement from '@/components/home/Engagement.astro';
import Closing from '@/components/home/Closing.astro';
import ProjectEnquirySelector from '@/components/home/ProjectEnquirySelector';
import { approvedServices } from '@/data/services';
---

<BaseLayout description="SabiForge Digital is a design and development studio in Nigeria creating distinctive websites, online stores and digital experiences for businesses at every stage.">
  <Hero />
  <div class="ticker" aria-label="Capabilities">
    <div class="ticker-track">
      <span>
        WEBSITE DESIGN • E-COMMERCE • REDESIGN • WEBSITE CARE • WEBSITE DESIGN • E-COMMERCE •
        REDESIGN • WEBSITE CARE •
      </span>
      <span aria-hidden="true">
        WEBSITE DESIGN • E-COMMERCE • REDESIGN • WEBSITE CARE • WEBSITE DESIGN • E-COMMERCE •
        REDESIGN • WEBSITE CARE •
      </span>
    </div>
  </div>
  <CaseStudies />
  <Services />
  <ProjectEnquirySelector
    client:load
    services={approvedServices.map(({ slug, name }) => ({ slug, name }))}
  />
  <Approach />
  <Engagement />
  <Closing />
</BaseLayout>
