---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import CaseStudies from '@/components/home/CaseStudies';
import Services from '@/components/home/Services.astro';
import Approach from '@/components/home/Approach.astro';
import Engagement from '@/components/home/Engagement.astro';
import Closing from '@/components/home/Closing.astro';
import ProjectCalculator from '@/components/home/ProjectCalculator';
---

<BaseLayout description="SabiForge Digital is a design and development studio in Nigeria creating distinctive websites, online stores and digital experiences for businesses at every stage.">
  <Hero />
  <div class="ticker" aria-label="Capabilities">
    <div class="ticker-track">
      <span>
        STRATEGY • DESIGN • BUILD • OPTIMIZATION • SHOPIFY • NEXT.JS • TAILWIND • STRATEGY • DESIGN
        • BUILD • OPTIMIZATION • SHOPIFY • NEXT.JS • TAILWIND •
      </span>
      <span aria-hidden="true">
        STRATEGY • DESIGN • BUILD • OPTIMIZATION • SHOPIFY • NEXT.JS • TAILWIND • STRATEGY • DESIGN
        • BUILD • OPTIMIZATION • SHOPIFY • NEXT.JS • TAILWIND •
      </span>
    </div>
  </div>
  <CaseStudies client:load />
  <Services />
  <ProjectCalculator client:load />
  <Approach />
  <Engagement />
  <Closing />
</BaseLayout>
