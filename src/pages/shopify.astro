---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import HexLines from '@/components/ui/HexLines.astro';
import ConceptPlate from '@/components/ui/ConceptPlate.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import CtaPanel from '@/components/page/CtaPanel.astro';
import StoreAnatomy from '@/components/shopify/StoreAnatomy';
import { offerings, platformRealities } from '@/data/commerce';
import { CONCEPT_LABEL } from '@/data/concepts';
---

<BaseLayout
  title="Shopify & e-commerce"
  description="Shopify store launches, storefront redesigns, theme enhancements, product discovery, mobile shopping, performance and ongoing support from SabiForge Digital, with the limits of each stated plainly."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden pt-32 pb-20 lg:pt-44 lg:pb-32">
    <div
      class="absolute inset-0 -z-20 bg-[radial-gradient(60%_60%_at_85%_30%,rgb(18_78_71/0.55),transparent),radial-gradient(35%_40%_at_5%_100%,rgb(254_103_79/0.09),transparent)]"
      aria-hidden="true"
    ></div>
    <HexLines
      class="absolute -right-48 -bottom-48 -z-10 size-[46rem] text-mint-300/[0.08]"
      rings={7}
    />
    <div class="container-page">
      <Breadcrumbs
        items={[{ label: 'Services', href: '/services' }, { label: 'Shopify & e-commerce' }]}
      />
      <div class="mt-10 grid gap-14 lg:grid-cols-[1.15fr_1fr] lg:items-center">
        <div>
          <p class="meta text-mint-300" data-reveal>
            Shopify &amp; e-commerce
          </p>
          <h1 class="mt-5 text-display-xl font-semibold text-ivory-50">
            Stores designed around how people <em class="text-mint-300">shop</em>.
          </h1>
          <p class="text-lede mt-8 max-w-xl text-ivory-100/80" data-reveal>
            From a first Shopify store to a long-overdue storefront redesign, we design and build
            the part of your business your customers actually see, and tell you plainly what it can
            and can’t do for you.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal>
            <Button
              href="/contact?service=shopify-ecommerce-development"
              size="lg"
              icon="arrow-up-right"
            >
              Plan a store
            </Button>
            <Button href="#offerings" variant="secondary" size="lg" icon="arrow-down">
              See what we do
            </Button>
          </div>
        </div>
        <figure data-reveal>
          <div class="plate-lift">
            <ConceptPlate variant="commerce" />
          </div>
          <figcaption class="meta mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-ivory-100/70">
            <span class="rounded-full border border-ivory-100/25 px-2.5 py-0.5 text-ivory-50">
              {CONCEPT_LABEL}
            </span>
            Kòrà Home, a fictional store.{' '}
            <a href="/work#kora-home" class="link-sweep text-mint-300">
              Read the study
            </a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Positioning -->
  <section aria-labelledby="scope-title" class="border-t border-ivory-100/10 py-20 lg:py-28">
    <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,26rem)_1fr] lg:gap-20">
      <div data-reveal>
        <p class="meta text-mint-300">(01) Who this is for</p>
        <h2 id="scope-title" class="mt-5 text-display-md font-semibold text-ivory-50">
          Commerce is one thing we do, <em class="text-mint-300">well</em>.
        </h2>
      </div>
      <div class="space-y-6" data-reveal>
        <p class="text-lg text-ivory-100/75">
          SabiForge is a design and development studio for businesses at every stage, and commerce
          is one part of that. Our store work is for several kinds of seller:
        </p>
        <ul class="grid gap-3 sm:grid-cols-2">
          {[
            ['New merchants', 'Launching a first store, including dropshipping businesses.'],
            [
              'Catalogue sellers',
              'Selling through WhatsApp, Instagram or a showroom, and needing a browsable catalogue.',
            ],
            ['Existing Shopify stores', 'Wanting a sharper, more trustworthy storefront.'],
            [
              'Established brands',
              'Selling online alongside other channels, and wanting the store to match the brand.',
            ],
          ].map(([t, d]) => (
            <li class="rounded-xl border border-ivory-100/12 p-5">
              <span class="block font-display text-lg font-semibold text-ivory-50">{t}</span>
              <span class="mt-1 block text-sm text-ivory-100/70">{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Anatomy -->
  <section
    aria-labelledby="anatomy-title"
    class="on-paper notch-tr bg-ivory-100 py-24 text-midnight-900 lg:py-32"
  >
    <div class="container-page">
      <div class="max-w-3xl" data-reveal>
        <p class="meta text-mint-800">(02) Anatomy of a storefront</p>
        <h2 id="anatomy-title" class="mt-5 text-display-lg font-semibold">
          Five places a store <em>wins or loses</em> a customer.
        </h2>
        <p class="mt-6 text-lg text-midnight-800/80">
          Select a part of the wireframe to see what we look at and the question we ask.
        </p>
      </div>
      <div class="mt-14" data-reveal>
        <StoreAnatomy client:visible />
        <noscript>
          <p class="mt-6">
            We look at navigation, collections, product pages, mobile shopping and performance on
            every store.
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <!-- Offerings -->
  <section id="offerings" aria-labelledby="offerings-title" class="py-24 lg:py-36">
    <div class="container-page">
      <div class="max-w-3xl" data-reveal>
        <p class="meta text-mint-300">(03) What we do</p>
        <h2 id="offerings-title" class="mt-5 text-display-lg font-semibold text-ivory-50">
          Eight kinds of commerce work, with their <em class="text-mint-300">limits</em> stated.
        </h2>
        <p class="mt-6 text-lg text-ivory-100/75">
          For each: who it’s for, what we do, why it matters to the business and what it can’t do.
          We don’t promise sales, traffic or conversion rates.
        </p>
      </div>
      <ol class="mt-16 border-t border-ivory-100/15">
        {offerings.map((o, i) => (
          <li class="border-b border-ivory-100/15 py-12 lg:py-16">
            <article
              aria-labelledby={`o-${o.id}`}
              class="grid gap-8 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16"
            >
              <header data-reveal>
                <span class="numeral block text-[4.5rem] sm:text-[6rem]" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3
                  id={`o-${o.id}`}
                  class="mt-4 flex items-start gap-3 font-display text-display-sm font-semibold text-ivory-50"
                >
                  <Icon name={o.icon} class="mt-1.5 size-6 shrink-0 text-mint-300" />
                  {o.name}
                </h3>
                <p class="mt-3 text-sm text-ivory-100/65">
                  <span class="font-semibold text-ivory-100/85">For: </span>
                  {o.forWhom}
                </p>
              </header>
              <div class="grid gap-8 md:grid-cols-2" data-reveal>
                <div class="space-y-6">
                  <div>
                    <h4 class="meta text-mint-300">What we do</h4>
                    <p class="mt-2 text-ivory-100/80">{o.what}</p>
                  </div>
                  <div>
                    <h4 class="meta text-mint-300">Why it matters</h4>
                    <p class="mt-2 text-ivory-100/80">{o.value}</p>
                  </div>
                </div>
                <div class="chamfer-sm border border-coral-400/35 bg-coral-400/[0.05] p-6">
                  <h4 class="meta flex items-center gap-2 text-coral-300">
                    <Icon name="alert" class="size-4" /> Limits and dependencies
                  </h4>
                  <ul class="mt-3 space-y-2.5 text-sm text-ivory-100/80">
                    {o.limits.map((l) => (
                      <li class="flex gap-2">
                        <span aria-hidden="true">·</span>
                        {l}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Platform realities + dropshipping + pricing -->
  <section
    aria-labelledby="reality-title"
    class="on-paper notch-bl bg-ivory-50 py-24 text-midnight-900 lg:py-32"
  >
    <div class="container-page">
      <div class="max-w-3xl" data-reveal>
        <p class="meta text-mint-800">(04) Who decides what</p>
        <h2 id="reality-title" class="mt-5 text-display-lg font-semibold">
          The honest <em>boundaries</em> of a storefront.
        </h2>
      </div>
      <ul class="mt-12 grid gap-8 md:grid-cols-3">
        {platformRealities.map((r) => (
          <li class="border-t-2 border-midnight-900 pt-5" data-reveal>
            <h3 class="font-display text-xl font-semibold">{r.title}</h3>
            <p class="mt-3 text-midnight-800/85">{r.detail}</p>
          </li>
        ))}
      </ul>

      <div class="mt-20 grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div data-reveal>
          <h3 class="meta text-mint-800">If you’re starting with dropshipping</h3>
          <p class="mt-4 font-display text-display-sm font-semibold">
            A trustworthy storefront is the part we can build.
          </p>
          <p class="mt-4 text-midnight-800/85">
            We design the store: structure, product pages, policies and the checkout path. Choosing
            suppliers, setting prices, running ads and fulfilling orders are your business decisions
            and aren’t included in a website build unless we agree them separately.
          </p>
        </div>
        <div data-reveal>
          <h3 class="meta text-mint-800">What it costs</h3>
          <p class="mt-4 font-display text-display-sm font-semibold">
            Online Catalog ₦500,000. Full E-commerce from ₦900,000.
          </p>
          <p class="mt-4 text-midnight-800/85">
            Package prices exclude third-party costs such as your Shopify plan, apps, themes and
            payment fees. Storefront redesigns and enhancements are scoped after a short review.
          </p>
          <a href="/pricing" class="link-sweep mt-5 inline-flex items-center gap-2 font-semibold">
            See packages and the founding rate <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaPanel
    title="Planning a <em>store</em>, or fixing one?"
    body="Tell us what you sell and who buys it. We’ll recommend the smallest sensible scope and tell you what to expect."
    primaryHref="/contact?service=shopify-ecommerce-development"
    whatsappMessage="Hello SabiForge Digital, I'd like to discuss a Shopify store."
  />
</BaseLayout>
