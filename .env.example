# Copy to .env and adjust for the target environment. Never commit real secrets;
# this site needs none. All values below are placeholders.

# Build environment. One of: development | staging | production
# - development (default): no URL restrictions, SITE_URL defaults to http://localhost:4321
# - staging: emits noindex,nofollow on every page and a robots.txt that disallows all crawlers
# - production: allows indexing; SITE_URL must exactly match the origin configured in astro.config.mjs
SITE_ENV=staging

# Public origin of the deployed site, used for canonical, sitemap and Open Graph URLs.
# For staging and production builds it must be a clean HTTPS origin: no path, port, query, hash
# or credentials; not localhost or an internal/private IP; and it must match the origin the site
# is actually served from. (Enforced by the guardrails in astro.config.mjs; the build fails otherwise.)
SITE_URL=https://staging.example.com
