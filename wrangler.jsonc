{
  // Static-assets deployment of the Astro build output for Cloudflare Workers Builds.
  // Build with SITE_ENV=staging and SITE_URL=https://sabiforge-digital-staging.pages.dev
  // (set as build variables in the Cloudflare project), then deploy with `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sabiforge-digital-staging",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
